{
  "schemaVersion": 1,
  "id": "google.gmail",
  "version": "1.0.0",
  "displayName": "Gmail",
  "description": "让 Agent 在用户授权范围内搜索、读取和整理 Gmail 邮件。",
  "author": { "name": "Spark Connectors" },
  "icon": "gmail",
  "homepageUrl": "https://support.google.com/mail/",
  "categories": ["communication", "google"],
  "tags": ["gmail", "email", "google"],
  "permissions": {
    "required": ["network", "secrets.read", "connector.account"],
    "optional": []
  },
  "activation": "on-demand",
  "contributions": {
    "skills": [
      {
        "id": "gmail-assistant",
        "path": "skills/gmail-assistant",
        "name": "Gmail 助手",
        "description": "帮助 Agent 安全地处理邮件任务。"
      }
    ],
    "mcpServers": [],
    "connectors": [
      {
        "id": "gmail",
        "permissions": ["network", "secrets.read", "connector.account"],
        "manifest": {
          "protocolVersion": "2026-06-25",
          "provider": "gmail",
          "displayName": "Gmail",
          "description": "通过 Google OAuth 访问 Gmail 邮箱能力。",
          "icon": "generic",
          "auth": [
            {
              "method": "oauth2",
              "flow": "authorization-code-pkce",
              "label": "Google OAuth",
              "recommendedFor": ["desktop", "team"],
              "secretFields": ["access_token", "refresh_token"],
              "secretStorage": "keystore",
              "scopes": ["https://www.googleapis.com/auth/gmail.readonly"]
            }
          ],
          "capabilities": [
            {
              "id": "identity",
              "label": "账号身份",
              "description": "读取当前 Gmail 账号身份。",
              "risk": "low",
              "enabledByDefault": true
            },
            {
              "id": "messages",
              "label": "邮件读取",
              "description": "搜索和读取用户授权范围内的邮件。",
              "requiredScopes": ["https://www.googleapis.com/auth/gmail.readonly"],
              "risk": "medium",
              "enabledByDefault": true
            }
          ],
          "endpoints": { "apiBaseUrl": "https://gmail.googleapis.com/gmail/v1" },
          "security": {
            "preferredAuthFlow": "authorization-code-pkce",
            "tokenStorage": "keystore",
            "supportsPkce": true,
            "supportsDeviceFlow": false,
            "supportsInstallationTokens": false,
            "notes": ["只申请只读 Gmail scope。", "刷新令牌必须由系统 keystore 保存。"]
          }
        }
      }
    ]
  }
}
