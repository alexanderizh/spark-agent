{
  "schemaVersion": 1,
  "id": "notion.workspace",
  "version": "1.0.0",
  "displayName": "Notion",
  "description": "让 Agent 在用户授权的 Notion 页面和数据库中检索与整理内容。",
  "author": { "name": "Spark Connectors" },
  "icon": "notion",
  "homepageUrl": "https://www.notion.so/help",
  "categories": ["productivity", "knowledge"],
  "tags": ["notion", "knowledge", "workspace"],
  "permissions": {
    "required": ["network", "secrets.read", "connector.account"],
    "optional": ["filesystem.read"]
  },
  "activation": "on-demand",
  "contributions": {
    "skills": [
      {
        "id": "notion-research",
        "path": "skills/notion-research",
        "name": "Notion 研究助手",
        "description": "帮助 Agent 从授权页面中提炼信息。"
      }
    ],
    "mcpServers": [],
    "connectors": [
      {
        "id": "notion",
        "permissions": ["network", "secrets.read", "connector.account"],
        "manifest": {
          "protocolVersion": "2026-06-25",
          "provider": "notion",
          "displayName": "Notion",
          "description": "通过 Notion OAuth 访问用户明确授权的页面和数据库。",
          "icon": "generic",
          "auth": [
            {
              "method": "oauth2",
              "flow": "authorization-code-pkce",
              "label": "Notion OAuth",
              "recommendedFor": ["desktop", "team"],
              "secretFields": ["access_token", "refresh_token"],
              "secretStorage": "keystore",
              "scopes": ["read_content"]
            }
          ],
          "capabilities": [
            {
              "id": "identity",
              "label": "工作区身份",
              "description": "读取当前 Notion 工作区身份。",
              "risk": "low",
              "enabledByDefault": true
            },
            {
              "id": "pages",
              "label": "页面检索",
              "description": "检索和读取用户授权的页面与数据库。",
              "requiredScopes": ["read_content"],
              "risk": "medium",
              "enabledByDefault": true
            }
          ],
          "endpoints": { "apiBaseUrl": "https://api.notion.com/v1" },
          "security": {
            "preferredAuthFlow": "authorization-code-pkce",
            "tokenStorage": "keystore",
            "supportsPkce": true,
            "supportsDeviceFlow": false,
            "supportsInstallationTokens": false,
            "notes": ["仅访问用户在 Notion 中明确分享给连接器的页面。", "令牌不得写入插件目录。"]
          }
        }
      }
    ]
  }
}
