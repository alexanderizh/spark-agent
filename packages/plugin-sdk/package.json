{
  "name": "@spark/plugin-sdk",
  "version": "0.1.0",
  "description": "SDK for authoring Spark connector runtimes",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./testing": "./src/testing.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "test:unit": "vitest run",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@spark/protocol": "workspace:*",
    "zod": "^3.23.0",
    "zod-to-json-schema": "3.25.2"
  },
  "devDependencies": {
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
