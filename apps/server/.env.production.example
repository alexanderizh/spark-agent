# ═══════════════════════════════════════════════════════════
# Spark Agent Server — 生产环境配置模板
# 复制为 .env.production 后填入实际值
# ═══════════════════════════════════════════════════════════

# ─── 应用 ──────────────────────────────────────────────
NODE_ENV=production
SERVER_PORT=7001
APP_KEYS=CHANGE_ME_TO_A_RANDOM_SECRET_STRING

# ─── PostgreSQL ────────────────────────────────────────
PG_HOST=postgres
PG_PORT=5432
PG_USER=spark
PG_PASSWORD=CHANGE_ME_STRONG_PASSWORD
PG_DATABASE=spark_agent

# ─── Redis ─────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── JWT ───────────────────────────────────────────────
JWT_SECRET=CHANGE_ME_TO_A_VERY_LONG_RANDOM_STRING
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ─── GitHub OAuth ──────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=https://your-domain.com/api/auth/oauth/github/callback

# ─── 微信开放平台 ─────────────────────────────────────
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_CALLBACK_URL=https://your-domain.com/api/auth/oauth/wechat/callback

# ─── 阿里云 SMS（手机验证码）──────────────────────────
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=

# ─── Docker Compose 部署参数 ───────────────────────────
# 镜像标签，留空则使用 latest
IMAGE_TAG=
# env 文件路径（docker compose --env-file 会用）
ENV_FILE=.env.production
