{
  "name": "@spark/server",
  "version": "0.1.0",
  "description": "Spark Agent server — Midway.js + TypeORM + PostgreSQL",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "scripts": {
    "dev": "dotenv -e .env -- tsx watch src/bootstrap.ts",
    "build": "tsc -p tsconfig.json",
    "start": "dotenv -e .env.production -- node ./bootstrap.js",
    "start:dev": "dotenv -e .env -- node ./bootstrap.js",
    "test": "vitest run",
    "test:unit": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "migration:generate": "dotenv -e .env -- typeorm-ts-node-esm migration:generate -d src/data-source.ts migrations/migration",
    "migration:run": "dotenv -e .env -- typeorm-ts-node-esm migration:run -d src/data-source.ts",
    "migration:revert": "dotenv -e .env -- typeorm-ts-node-esm migration:revert -d src/data-source.ts",
    "docker:up": "docker compose -f docker-compose.dev.yml --env-file .env up -d",
    "docker:down": "docker compose -f docker-compose.dev.yml down",
    "docker:deploy": "docker compose --env-file .env.production up -d",
    "docker:deploy:down": "docker compose down",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "dependencies": {
    "@midwayjs/bootstrap": "^3.20.24",
    "@midwayjs/core": "^3.20.0",
    "@midwayjs/jwt": "^3.20.0",
    "@midwayjs/koa": "^3.20.0",
    "@midwayjs/logger": "^4.0.1",
    "@midwayjs/typeorm": "^3.20.0",
    "@midwayjs/validate": "^3.20.0",
    "bcryptjs": "^2.4.3",
    "dotenv": "^17.4.2",
    "ioredis": "^5.6.0",
    "pg": "^8.16.0",
    "typeorm": "^0.3.22",
    "uuid": "^11.0.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.0.0",
    "@types/uuid": "^10.0.0",
    "dotenv-cli": "^11.0.0",
    "tsx": "^4.22.4",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
