# ═══════════════════════════════════════════════════════
# Spark Agent Server — 环境变量模板
# 复制为 .env 后填入实际值：
#   开发：cp .env.example .env
#   生产：cp .env.example .env.production
# ═══════════════════════════════════════════════════════

# ─── 应用 ──────────────────────────────────────────────
NODE_ENV=development
SERVER_PORT=7001
APP_KEYS=spark-agent-server-keys-change-in-production

# ─── PostgreSQL ────────────────────────────────────────
PG_HOST=localhost
PG_PORT=5432
PG_USER=spark
PG_PASSWORD=spark_dev
PG_DATABASE=spark_agent

# ─── Redis ─────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ─── JWT ───────────────────────────────────────────────
JWT_SECRET=spark-dev-jwt-secret-change-in-production
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ─── GitHub OAuth ──────────────────────────────────────
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:7001/api/auth/oauth/github/callback

# ─── 微信开放平台 ─────────────────────────────────────
WECHAT_APP_ID=
WECHAT_APP_SECRET=
WECHAT_CALLBACK_URL=http://localhost:7001/api/auth/oauth/wechat/callback

# ─── 阿里云 SMS（手机验证码）──────────────────────────
ALIYUN_SMS_ACCESS_KEY_ID=
ALIYUN_SMS_ACCESS_KEY_SECRET=
ALIYUN_SMS_SIGN_NAME=
ALIYUN_SMS_TEMPLATE_CODE=
