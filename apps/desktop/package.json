{
  "name": "@spark/desktop",
  "version": "0.1.32",
  "description": "Spark Agent desktop application — Electron + React + TypeScript",
  "author": "Spark Agent Team",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "build:unpack": "electron-vite build && electron-builder --dir",
    "build:prod": "electron-vite build && electron-builder",
    "build:win": "electron-vite build && electron-builder --win --x64",
    "build:mac": "electron-vite build && electron-builder --mac --arm64 --x64",
    "build:mac:arm64": "electron-vite build && electron-builder --mac --arm64",
    "build:mac:x64": "electron-vite build && electron-builder --mac --x64",
    "build:win:release": "bash scripts/build-win-release.sh x64",
    "build:linux": "electron-vite build && electron-builder --linux",
    "build:all": "electron-vite build && electron-builder --mac --arm64 --x64 && electron-builder --win --x64",
    "pack": "electron-builder --dir",
    "preview": "electron-vite preview",
    "download-browser": "node scripts/download-browser.js",
    "rebuild:native": "electron-rebuild -f -w node-pty,better-sqlite3,keytar",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test:unit": "vitest run",
    "test:e2e": "playwright test",
    "lint": "eslint src --ext .ts,.tsx"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.66.1",
    "@lobehub/fluent-emoji": "^4.1.0",
    "@lobehub/icons": "^5.10.0",
    "@lobehub/ui": "^5.15.15",
    "@lobehub/webfont-geist": "^1.0.0",
    "@lobehub/webfont-geist-mono": "^1.0.0",
    "@lobehub/webfont-harmony-sans-sc": "^1.0.0",
    "@playwright/mcp": "^0.0.30",
    "@rc-component/qrcode": "^1.1.1",
    "@spark/protocol": "workspace:*",
    "@spark/shared": "workspace:*",
    "@spark/storage": "workspace:*",
    "@xyflow/react": "^12.3.5",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "antd": "^6.4.4",
    "better-sqlite3": "^11.10.0",
    "electron-updater": "^6.8.3",
    "js-yaml": "^4.1.1",
    "katex": "^0.17.0",
    "keytar": "^7.9.0",
    "lucide-react": "^1.16.0",
    "motion": "^12.40.0",
    "node-pty": "^1.1.0",
    "openai": "^6.39.0",
    "playwright": "^1.49.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.15.1",
    "shiki": "^4.2.0"
  },
  "devDependencies": {
    "@electron-toolkit/preload": "^3.0.0",
    "@electron-toolkit/utils": "^3.0.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.45.0",
    "@tailwindcss/vite": "^4.3.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "electron": "^31.0.0",
    "electron-builder": "^24.13.0",
    "electron-rebuild": "^3.2.9",
    "electron-vite": "^2.3.0",
    "eslint": "^10.4.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "less": "^4.6.4",
    "tailwindcss": "^4.3.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.60.0",
    "vitest": "^2.0.0"
  },
  "optionalDependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.153"
  }
}
