/* ─── 徽标 / 状态点 ────────────────────────────────────────────────────────── */

.badge {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  line-height: 1.5;
  font-weight: 500;
}
.badge-success {
  background: rgba(16, 185, 129, 0.12);
  color: #059669;
}
.badge-warning {
  background: rgba(245, 158, 11, 0.14);
  color: #b45309;
}
.badge-danger {
  background: rgba(239, 68, 68, 0.12);
  color: #dc2626;
}
.badge-info {
  background: rgba(59, 130, 246, 0.12);
  color: #2563eb;
}
.badge-review {
  background: rgba(236, 72, 153, 0.12);
  color: #db2777;
}
.badge-neutral {
  background: #f0efed;
  color: #8e8e8e;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  flex: none;
}
.dot-success {
  background: #10b981;
}
.dot-warning {
  background: #f59e0b;
}
.dot-danger {
  background: #ef4444;
}
.dot-info {
  background: #3b82f6;
}
.dot-neutral {
  background: #c9c6c0;
}

/* ─── 表单 ─────────────────────────────────────────────────────────────────── */

.field {
  margin-bottom: 24rpx;
}
.field-label {
  font-size: 26rpx;
  color: #8e8e8e;
  margin-bottom: 10rpx;
  display: block;
}
.field-input {
  height: 88rpx;
  background: #fff;
  border: 1rpx solid #e5e2dd;
  border-radius: 20rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #1a1a1a;
  width: 100%;
  box-sizing: border-box;
}
.field-input:focus {
  border-color: #1a1a1a;
}

/* ─── 按钮 ─────────────────────────────────────────────────────────────────── */

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 999rpx;
  font-size: 30rpx;
  font-weight: 500;
  padding: 0 36rpx;
  box-sizing: border-box;
}
.btn-dark {
  background: #1a1a1a;
  color: #fff;
}
.btn-dark[disabled] {
  background: #4d4d4d;
  color: #fff;
}
.btn-plain {
  background: #fff;
  color: #1a1a1a;
  border: 1rpx solid #e5e2dd;
}
.btn-plain--hover {
  background: #f2f1ef;
}
/* 主按钮：Cursor 式黑底白字胶囊（彩色仅用于状态，主操作用黑） */
.btn-primary {
  background: #1a1a1a;
  color: #fff;
}
.btn-primary[disabled] {
  background: #4d4d4d;
  color: #fff;
}
.btn-primary--hover {
  background: #3d3d3d;
}
.btn-danger-plain {
  background: #fff;
  color: #dc2626;
  border: 1rpx solid #f3c1c1;
}
.btn-block {
  width: 100%;
}
.btn-small {
  height: 64rpx;
  font-size: 26rpx;
  padding: 0 28rpx;
}
.btn-loading {
  opacity: 0.7;
}

/* ─── 空态（图标 + 标题 + 指引文案 三件套） ────────────────────────────────── */

.empty-state {
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  padding: 40rpx 8rpx;
}

/* 卡片内居中空态（同步/设备等列表为空时） */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 88rpx 48rpx;
  text-align: center;
  color: #6b6b6b;
  font-size: 28rpx;
}
.empty-icon {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #efedea;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
}
.empty-state-icon {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  background: #efedea;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
}
.empty-state-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
  margin-bottom: 8rpx;
}
.empty-state-desc {
  font-size: 26rpx;
  color: #8e8e8e;
  line-height: 1.6;
}

/* ─── 分割线 ───────────────────────────────────────────────────────────────── */

.divider {
  height: 1rpx;
  background: #ececec;
}

/* ─── 安全区（iPhone 底部横条 / 刘海屏顶部） ───────────────────────────────── */

.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}
.safe-top {
  padding-top: var(--status-bar-height, 44px);
}

/* ─── 加载态 ───────────────────────────────────────────────────────────────── */

.loading-tip {
  text-align: center;
  padding: 48rpx 0;
  color: #b3b0ab;
  font-size: 26rpx;
}
