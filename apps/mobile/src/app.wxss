/*
 * SparkWork 移动端全局样式 — Cursor 移动端风格重构。
 *
 * 设计令牌（对齐 Cursor iOS App，浅色暖白主题）：
 *   背景 #F7F6F4 / 卡片 #FFFFFF / 主文字 #1A1A1A / 次级 #8E8E8E / 分割线 #ECECEC
 *   用户气泡 #E9E9E7；彩色仅用于状态：运行蓝 / 需关注橙黄 / 异常红 / 待审查品红 / 完成绿。
 * 注意：wxss 不依赖 CSS 自定义属性（规避低版本基础库兼容问题），全部用字面值类名。
 */

page {
  background: #f7f6f4;
  font-family:
    -apple-system, BlinkMacSystemFont, 'PingFang SC', 'HarmonyOS Sans', 'Helvetica Neue', sans-serif;
  font-size: 30rpx;
  line-height: 1.6;
  color: #1a1a1a;
  -webkit-font-smoothing: antialiased;
}

/* ─── 文本 ─────────────────────────────────────────────────────────────────── */

.t-strong {
  color: #1a1a1a;
  font-weight: 600;
}
.t {
  color: #1a1a1a;
}
.t-2 {
  color: #6b6b6b;
}
.t-muted {
  color: #8e8e8e;
}
.t-faint {
  color: #b3b0ab;
}
.t-accent {
  color: #3b82f6;
}

/* 页面大标题：左对齐加粗（Cursor 式） */
.page-title {
  font-size: 56rpx;
  font-weight: 700;
  color: #1a1a1a;
  letter-spacing: 0.5rpx;
}

/* 分组标题：灰色小字 */
.group-title {
  font-size: 26rpx;
  font-weight: 500;
  color: #8e8e8e;
  letter-spacing: 0.5rpx;
}

.t-caption {
  font-size: 22rpx;
  color: #8e8e8e;
}
/* 卡片内主标题（昵称等）与次级说明（账号掩码、slogan 等） */
.t-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #1a1a1a;
}
.t-subtitle {
  font-size: 26rpx;
  color: #6b6b6b;
}
.t-mono {
  font-family: 'SF Mono', Menlo, Consolas, monospace;
  font-size: 24rpx;
}

.ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.ellipsis-2 {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* ─── 布局 ─────────────────────────────────────────────────────────────────── */

.page {
  min-height: 100vh;
  box-sizing: border-box;
}
.row {
  display: flex;
  flex-direction: row;
  align-items: center;
}
.col {
  display: flex;
  flex-direction: column;
}
.between {
  justify-content: space-between;
}
.center {
  justify-content: center;
  align-items: center;
}
.grow {
  flex: 1;
  min-width: 0;
}
.gap-8 {
  gap: 8rpx;
}
.gap-12 {
  gap: 12rpx;
}
.gap-16 {
  gap: 16rpx;
}
.gap-24 {
  gap: 24rpx;
}

/* ─── 卡片（白底上浮，极淡阴影，16px 圆角） ────────────────────────────────── */

.card {
  background: #fff;
  border-radius: 32rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(26, 26, 26, 0.04);
}
/* 扁平变体：说明性/次要卡片去阴影 */
.card-flat {
  box-shadow: none;
}

/* 状态仪表盘 2×2 卡片（紧凑横排：图标 + 标签 + 右侧计数） */
.stat-card {
  background: #fff;
  border-radius: 24rpx;
  padding: 20rpx 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(26, 26, 26, 0.04);
  display: flex;
  flex-direction: row;
  align-items: center;
  box-sizing: border-box;
}
.stat-card-icon {
  width: 32rpx;
  height: 32rpx;
  background-size: 32rpx 32rpx;
  flex: none;
}
.stat-card-label {
  font-size: 26rpx;
  font-weight: 500;
  color: #1a1a1a;
  margin-left: 14rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.stat-card-count {
  font-size: 26rpx;
  color: #b3b0ab;
  margin-left: auto;
  flex: none;
}

/* 卡片内分组标题（「账号与安全」等小节头），与首页 group-title 同风格 */
.card-head {
  padding: 4rpx 0 8rpx;
}
.card-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #8e8e8e;
  letter-spacing: 0.5rpx;
}

/* ─── 列表行（无容器白底直排 + 缩进式细分割线） ────────────────────────────── */

.list-row-label {
  font-size: 30rpx;
  color: #1a1a1a;
}
.list-row-value {
  font-size: 26rpx;
  color: #8e8e8e;
  text-align: right;
}
.list-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  min-height: 108rpx;
  padding: 20rpx 0;
}
.list-row + .list-row {
  border-top: 1rpx solid #ececec;
}

/* ─── 圆形按钮（白底 + 细描边 + 微阴影，88rpx 直径） ───────────────────────── */

.circle-btn {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #fff;
  border: 1rpx solid #ececec;
  box-shadow: 0 2rpx 8rpx rgba(26, 26, 26, 0.05);
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  box-sizing: border-box;
}
.circle-btn:active {
  background: #f2f1ef;
}
.circle-btn--sm {
  width: 68rpx;
  height: 68rpx;
}
.circle-btn--ghost {
  background: transparent;
  border-color: transparent;
  box-shadow: none;
}

/* 通用触摸态（hover-class 用类名，不能用 :active 伪类） */
.hover-dim {
  opacity: 0.72;
}

/* SVG 图标（data URL，统一 #1A1A1A 或指定色） */
