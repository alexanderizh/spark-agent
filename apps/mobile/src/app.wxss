/*
 * SparkWork 移动端全局样式。
 *
 * 设计令牌与桌面端一致（apps/desktop/src/renderer/design/styles/styles.css）：
 *   中性灰、无渐变、紧凑密度、彩色语义图标；主色 #3b82f6。
 * 注意：wxss 不依赖 CSS 自定义属性（规避低版本基础库兼容问题），全部用字面值类名。
 */

page {
  background: #fafafa;
  font-family:
    -apple-system, BlinkMacSystemFont, 'PingFang SC', 'HarmonyOS Sans', 'Helvetica Neue', sans-serif;
  font-size: 28rpx;
  line-height: 1.5;
  color: #23231f;
}

/* ─── 文本 ─────────────────────────────────────────────────────────────────── */

.t-strong {
  color: #11100e;
  font-weight: 600;
}
.t {
  color: #23231f;
}
.t-muted {
  color: #8d8a86;
}
.t-faint {
  color: #9b9489;
}
.t-primary {
  color: #3b82f6;
}
.t-success {
  color: #10b981;
}
.t-warning {
  color: #f59e0b;
}
.t-danger {
  color: #ef4444;
}

.t-title {
  font-size: 34rpx;
  font-weight: 600;
  color: #11100e;
}
.t-subtitle {
  font-size: 26rpx;
  color: #8d8a86;
}
.t-caption {
  font-size: 22rpx;
  color: #9b9489;
}
.t-mono {
  font-family: 'SF Mono', Menlo, Consolas, monospace;
  font-size: 24rpx;
}

.ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}
.ellipsis-2 {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

/* ─── 布局 ─────────────────────────────────────────────────────────────────── */

.page {
  padding: 24rpx 24rpx 48rpx;
  min-height: 100vh;
  box-sizing: border-box;
}
.row {
  display: flex;
  flex-direction: row;
  align-items: center;
}
.col {
  display: flex;
  flex-direction: column;
}
.between {
  justify-content: space-between;
}
.center {
  justify-content: center;
  align-items: center;
}
.grow {
  flex: 1;
  min-width: 0;
}
.gap-8 {
  gap: 8rpx;
}
.gap-12 {
  gap: 12rpx;
}
.gap-16 {
  gap: 16rpx;
}
.gap-24 {
  gap: 24rpx;
}
.wrap {
  flex-wrap: wrap;
}

/* ─── 卡片 ─────────────────────────────────────────────────────────────────── */

.card {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 1rpx 4rpx rgba(17, 16, 14, 0.04);
}
.card-flat {
  background: #fff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin-bottom: 24rpx;
}
.card-head {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}
.card-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #11100e;
}
.card-action {
  font-size: 24rpx;
  color: #3b82f6;
}

/* ─── 列表行 ───────────────────────────────────────────────────────────────── */

.list-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  padding: 22rpx 0;
  border-bottom: 1rpx solid #efede8;
  font-size: 28rpx;
}
.list-row:last-child {
  border-bottom: none;
}
.list-row-label {
  color: #23231f;
}
.list-row-value {
  color: #8d8a86;
  font-size: 26rpx;
}

/* ─── 按钮 ─────────────────────────────────────────────────────────────────── */

.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 12rpx;
  font-size: 30rpx;
  font-weight: 500;
  padding: 0 32rpx;
  box-sizing: border-box;
}
.btn-primary {
  background: #3b82f6;
  color: #fff;
}
.btn-primary[disabled] {
  background: #a8c7fa;
  color: #fff;
}
.btn-plain {
  background: #fff;
  color: #23231f;
  border: 1rpx solid #d7d2c9;
}
.btn-danger-plain {
  background: #fff;
  color: #ef4444;
  border: 1rpx solid #f3c1c1;
}
.btn-block {
  width: 100%;
}
.btn-small {
  height: 64rpx;
  font-size: 26rpx;
  border-radius: 8rpx;
  padding: 0 24rpx;
}
.btn-loading {
  opacity: 0.7;
}

/* ─── 徽标 / 状态点 ────────────────────────────────────────────────────────── */

.badge {
  display: inline-flex;
  align-items: center;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  font-size: 22rpx;
  line-height: 1.4;
}
.badge-success {
  background: rgba(16, 185, 129, 0.12);
  color: #10b981;
}
.badge-warning {
  background: rgba(245, 158, 11, 0.12);
  color: #f59e0b;
}
.badge-danger {
  background: rgba(239, 68, 68, 0.12);
  color: #ef4444;
}
.badge-info {
  background: rgba(59, 130, 246, 0.12);
  color: #3b82f6;
}
.badge-neutral {
  background: #f2f2f2;
  color: #8d8a86;
}

.dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  flex: none;
}
.dot-success {
  background: #10b981;
}
.dot-warning {
  background: #f59e0b;
}
.dot-danger {
  background: #ef4444;
}
.dot-neutral {
  background: #d7d2c9;
}

/* ─── 表单 ─────────────────────────────────────────────────────────────────── */

.field {
  margin-bottom: 24rpx;
}
.field-label {
  font-size: 26rpx;
  color: #8d8a86;
  margin-bottom: 10rpx;
  display: block;
}
.field-input {
  height: 88rpx;
  background: #fff;
  border: 1rpx solid #d7d2c9;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 28rpx;
  color: #23231f;
  width: 100%;
  box-sizing: border-box;
}
.field-input:focus {
  border-color: #3b82f6;
}

/* ─── 空态 ─────────────────────────────────────────────────────────────────── */

.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 96rpx 48rpx;
  color: #9b9489;
  font-size: 26rpx;
}
.empty-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
  opacity: 0.6;
}

/* ─── 分段控件（登录模式切换） ──────────────────────────────────────────────── */

.segment {
  display: flex;
  flex-direction: row;
  background: #f2f2f2;
  border-radius: 12rpx;
  padding: 6rpx;
  margin-bottom: 28rpx;
}
.segment-item {
  flex: 1;
  text-align: center;
  padding: 14rpx 0;
  font-size: 26rpx;
  color: #8d8a86;
  border-radius: 8rpx;
}
.segment-item.active {
  background: #fff;
  color: #11100e;
  font-weight: 500;
  box-shadow: 0 1rpx 4rpx rgba(17, 16, 14, 0.06);
}

/* ─── 头像 ─────────────────────────────────────────────────────────────────── */

.avatar {
  width: 96rpx;
  height: 96rpx;
  border-radius: 50%;
  background: #f2f2f2;
  flex: none;
}
.avatar-large {
  width: 128rpx;
  height: 128rpx;
  border-radius: 50%;
  background: #f2f2f2;
  flex: none;
}

/* ─── 分割线 ───────────────────────────────────────────────────────────────── */

.divider {
  height: 1rpx;
  background: #efede8;
  margin: 24rpx 0;
}

/* ─── 安全区（iPhone 底部横条） ────────────────────────────────────────────── */

.safe-bottom {
  padding-bottom: env(safe-area-inset-bottom);
}
