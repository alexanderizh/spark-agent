.password-page {
  padding: 24rpx 24rpx 48rpx;
}

.captcha-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
}
.captcha-input {
  flex: 1;
  min-width: 0;
}

.field-hint {
  display: block;
  margin-top: 8rpx;
}

.notice {
  margin-top: 24rpx;
  padding: 16rpx 20rpx;
  background: rgba(245, 158, 11, 0.08);
  border-radius: 8rpx;
  line-height: 1.6;
  color: #8d8a86;
}

.btn-primary--hover {
  background: #2563eb;
}
.btn-plain--hover {
  background: #f7f7f5;
}

/* ─── 短信服务停用期间：整页禁用引导态 ─────────────────────────────────────── */
.sms-disabled-hint {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
  padding: 32rpx 8rpx 16rpx;
}
.sms-disabled-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
}
.sms-disabled-desc {
  font-size: 26rpx;
  line-height: 1.7;
  color: #8d8a86;
}
