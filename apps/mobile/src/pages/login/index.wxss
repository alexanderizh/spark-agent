.login-page {
  padding: 64rpx 40rpx 64rpx;
  min-height: 100vh;
  box-sizing: border-box;
}

/* ─── 品牌区 ───────────────────────────────────────────────────────────────── */

.brand {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 24rpx 0 56rpx;
}
.brand-logo {
  width: 120rpx;
  height: 120rpx;
  border-radius: 28rpx;
  background: #3b82f6;
  color: #fff;
  font-size: 56rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  box-shadow: 0 8rpx 24rpx rgba(59, 130, 246, 0.28);
}
.brand-name {
  font-size: 40rpx;
  margin-bottom: 10rpx;
}
.brand-slogan {
  text-align: center;
}

/* ─── 登录方式分段控制器（iOS 风格：灰底容器 + 白底滑块选中态） ─────────────── */

.segment {
  display: flex;
  flex-direction: row;
  background: #efedea;
  border-radius: 20rpx;
  padding: 6rpx;
  margin-bottom: 40rpx;
}
.segment-item {
  flex: 1;
  height: 72rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #6b6b6b;
  border-radius: 15rpx;
  transition: background-color 0.15s ease;
}
.segment-item.active {
  background: #fff;
  color: #1a1a1a;
  font-weight: 600;
  box-shadow: 0 2rpx 8rpx rgba(26, 26, 26, 0.08);
}

/* ─── 表单细节 ─────────────────────────────────────────────────────────────── */

.captcha-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
}
.captcha-input {
  flex: 1;
  min-width: 0;
}

.submit-btn {
  margin-top: 16rpx;
}

.toggle-register {
  text-align: center;
  margin-top: 32rpx;
  color: #3b82f6;
}

.agreement {
  text-align: center;
  margin-top: 56rpx;
  line-height: 1.6;
}

/* ─── hover 态 ─────────────────────────────────────────────────────────────── */
/* btn-plain--hover / btn-primary--hover 已在 app.wxss 全局定义 */
