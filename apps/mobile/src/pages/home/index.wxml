<!-- 首页 Inbox：头像/搜索工具行 → 大标题 → 状态仪表盘 → 项目 → 最近会话 → 悬浮胶囊 -->

<view class="home-page">
  <!-- 顶部工具行（状态栏安全区） -->
  <view class="home-header" style="padding-top: {{statusBarHeight}}px;">
    <view class="home-toolbar row between" style="padding-right: {{navClearance}}px;">
      <view class="home-avatar-wrap" hover-class="home-avatar-wrap--hover" bindtap="onGoProfile">
        <image
          wx:if="{{avatarUrl}}"
          class="home-avatar"
          src="{{avatarUrl}}"
          mode="aspectFill"
        />
        <view wx:else class="home-avatar home-avatar--fallback center">
          <text>{{accountLabel ? accountLabel[0] : 'S'}}</text>
        </view>
      </view>
      <view class="row gap-16">
        <view class="circle-btn" hover-class="hover-dim" bindtap="onOpenSearch">
          <view class="icon icon-search"></view>
        </view>
        <view class="circle-btn" hover-class="hover-dim" bindtap="onNewProjectHint">
          <view class="icon icon-folder-plus"></view>
        </view>
      </view>
    </view>
    <view class="home-title-row">
      <text class="page-title">会话</text>
    </view>
  </view>

  <!-- ─── 链路失败态（多为电脑端离线 / 中继未开启） ─────────────────────────── -->
  <view wx:if="{{gate !== 'ok'}}" class="home-gate">
    <empty-state icon="monitor" title="连不上电脑端" desc="{{errorText}}" />
    <view class="row gap-16 home-gate-actions">
      <view class="btn btn-dark btn-small" hover-class="hover-dim" bindtap="onRetryLoad">
        <text>重试</text>
      </view>
    </view>
    <text wx:if="{{errorHint}}" class="t-caption home-gate-hint">{{errorHint}}</text>
  </view>

  <!-- ─── 内容态 ──────────────────────────────────────────────────────────── -->
  <block wx:else>
    <!-- 2×2 状态仪表盘（Cursor Inbox 式竖排白卡） -->
    <view class="stat-grid" wx:if="{{!loading || sessionTotal > 0}}">
      <view class="stat-card" hover-class="stat-card--hover" bindtap="onOpenAll">
        <view class="icon icon-chat stat-card-icon"></view>
        <view class="stat-card-foot">
          <text class="stat-card-label">全部会话</text>
          <text class="stat-card-count">{{stats.total}}</text>
        </view>
      </view>
      <view class="stat-card" hover-class="stat-card--hover" bindtap="onOpenAll">
        <view class="icon icon-working stat-card-icon"></view>
        <view class="stat-card-foot">
          <text class="stat-card-label">进行中</text>
          <text class="stat-card-count">{{stats.running}}</text>
        </view>
      </view>
      <view class="stat-card" hover-class="stat-card--hover" bindtap="onOpenAll">
        <view class="icon icon-bell stat-card-icon"></view>
        <view class="stat-card-foot">
          <text class="stat-card-label">异常</text>
          <text class="stat-card-count">{{stats.error}}</text>
        </view>
      </view>
      <view class="stat-card" hover-class="stat-card--hover" bindtap="onOpenAll">
        <view class="icon icon-review stat-card-icon"></view>
        <view class="stat-card-foot">
          <text class="stat-card-label">项目</text>
          <text class="stat-card-count">{{stats.projects}}</text>
        </view>
      </view>
    </view>

    <view wx:if="{{loading && sessionTotal === 0}}" class="loading-tip">加载中…</view>

    <!-- 项目列表加载失败提示（桌面端旧版本无项目端点时最常见） -->
    <view class="home-group" wx:if="{{projectsError}}">
      <view class="projects-error">
        <text class="t-caption">项目列表加载失败：请确认桌面端已更新到最新版本并重启，然后下拉刷新重试</text>
      </view>
    </view>

    <!-- 项目分组（Cursor Workspaces 式：新建行 + 单行项目条目，缩进分割线） -->
    <view class="home-group" wx:if="{{projects.length > 0 || projectsError}}">
      <view class="group-title home-group-title">项目</view>
      <view
        class="list-row home-row"
        hover-class="list-row--hover"
        bindtap="onNewProjectHint"
      >
        <view class="icon icon-plus home-row-icon home-row-icon--accent"></view>
        <text class="home-row-title home-row-title--action">新建项目</text>
      </view>
      <view
        wx:for="{{projects}}"
        wx:key="id"
        class="list-row home-row"
        hover-class="list-row--hover"
        data-id="{{item.id}}"
        data-name="{{item.name}}"
        bindtap="onOpenProject"
      >
        <view class="icon icon-folder home-row-icon"></view>
        <text class="home-row-title ellipsis">{{item.name}}</text>
        <view class="icon icon-chevron"></view>
      </view>
    </view>

    <!-- 会话（按项目分组，临时会话置底） -->
    <view class="home-group" wx:if="{{sessionTotal > 0}}">
      <view class="row between home-group-head">
        <view class="group-title">会话</view>
        <text class="t-caption t-accent" bindtap="onOpenAll">全部 ›</text>
      </view>
      <block wx:for="{{sessionGroups}}" wx:for-item="group" wx:key="key">
        <view
          class="row between home-group-subhead"
          hover-class="{{group.projectId ? 'list-row--hover' : ''}}"
          data-project-id="{{group.projectId}}"
          data-name="{{group.name}}"
          bindtap="onOpenGroup"
        >
          <view class="row gap-8 home-subhead-text">
            <view wx:if="{{!group.isTemp}}" class="icon icon-folder-small"></view>
            <text class="home-subhead-title">{{group.name}}</text>
          </view>
          <text class="t-caption">{{group.sessions.length}} 条{{group.projectId ? ' ›' : ''}}</text>
        </view>
        <view
          wx:for="{{group.sessions}}"
          wx:for-item="session"
          wx:key="id"
          class="list-row list-row--nested"
          hover-class="list-row--hover"
          data-id="{{session.id}}"
          data-title="{{session.title}}"
          bindtap="onOpenSession"
        >
          <view class="dot {{session.dotClass}}"></view>
          <view class="grow col gap-8 home-session-text">
            <text class="t-strong ellipsis">{{session.title}}</text>
            <text class="t-caption ellipsis">{{session.statusLabel}} · {{session.timeLabel}}{{session.preview ? ' · ' + session.preview : ''}}</text>
          </view>
        </view>
      </block>
    </view>

    <view
      wx:if="{{!loading && sessionTotal === 0 && projects.length === 0}}"
      class="home-gate"
    >
      <empty-state
        icon="chat"
        title="还没有会话"
        desc="在下方输入框说点什么，会话会发送到所选电脑"
      />
    </view>

    <!-- 底部胶囊占位 -->
    <view class="home-spacer"></view>
  </block>

  <!-- 底部悬浮胶囊输入框（快速发起） -->
  <capsule-composer
    wx:if="{{gate === 'ok'}}"
    mode="float"
    value="{{quickText}}"
    placeholder="发起新对话…"
    disabled="{{quickSending}}"
    bind:input="onQuickInput"
    bind:send="onQuickSend"
  />
</view>
