<view class="home-page">
  <view class="home-header" style="padding-top: {{statusBarHeight}}px;">
    <view class="home-toolbar row between" style="padding-right: {{navClearance}}px;">
      <view class="home-avatar-wrap" hover-class="home-avatar-wrap--hover" bindtap="onGoProfile">
        <image wx:if="{{avatarUrl}}" class="home-avatar" src="{{avatarUrl}}" mode="aspectFill" />
        <view wx:else class="home-avatar home-avatar--fallback center">
          <text>{{accountLabel ? accountLabel[0] : 'S'}}</text>
        </view>
      </view>
      <view class="home-manage" bindtap="onOpenBridgeDevices">授信设备管理</view>
    </view>
    <view class="home-title-row">
      <text class="page-title">远程会话</text>
      <text class="home-subtitle">先选电脑，再进入它自己的项目与会话</text>
    </view>
  </view>

  <view class="home-section-head row between">
    <text class="group-title">电脑</text>
    <text class="t-caption">{{devices.length}} 台已授信</text>
  </view>

  <view wx:if="{{devicesLoading}}" class="home-state">
    <view class="loading-tip">正在获取已授信电脑…</view>
  </view>

  <view wx:elif="{{devicesError}}" class="home-state">
    <empty-state icon="monitor" title="电脑列表加载失败" desc="{{devicesError}}" />
    <view class="home-action" bindtap="onRetry">重试</view>
  </view>

  <view wx:elif="{{devicesLoaded && devices.length === 0}}" class="home-state">
    <empty-state
      icon="monitor"
      title="还没有授信电脑"
      desc="在桌面端登录同一 Spark 平台账号并开启云端中继，电脑首次连接后会出现在这里。"
    />
    <view class="home-action" bindtap="onOpenBridgeDevices">管理授信设备</view>
  </view>

  <view wx:else class="home-device-list">
    <view
      wx:for="{{devices}}"
      wx:key="deviceId"
      class="home-device-card {{selectedDeviceId === item.deviceId ? 'home-device-card--selected' : ''}}"
      hover-class="home-device-card--hover"
      data-id="{{item.deviceId}}"
      bindtap="onPickDevice"
    >
      <view class="row between home-device-heading">
        <view class="row gap-12 grow home-device-name-wrap">
          <view class="home-device-icon">
            <view class="icon icon-monitor"></view>
          </view>
          <text class="home-device-name ellipsis">{{item.name}}</text>
        </view>
        <view class="row gap-8 home-device-status">
          <view class="home-device-dot {{item.online ? 'home-device-dot--on' : ''}}"></view>
          <text>{{item.online ? '在线' : '离线'}}</text>
        </view>
      </view>
      <view class="row between home-device-footer">
        <text class="t-caption"
          >{{item.online ? '查看这台电脑的项目' : '电脑连接中继后即可浏览'}}</text
        >
        <view wx:if="{{item.online}}" class="icon icon-chevron"></view>
      </view>
    </view>
  </view>

  <view
    class="home-composer"
    style="bottom: {{keyboardHeight}}px; padding-bottom: env(safe-area-inset-bottom);"
  >
    <view
      class="home-config-trigger row"
      hover-class="home-config-trigger--hover"
      bindtap="onOpenConfig"
    >
      <text class="home-config-tag">会话配置</text>
      <text class="home-config-summary ellipsis">{{configSummary}}</text>
      <view class="icon icon-chevron-down home-config-chevron"></view>
    </view>
    <view wx:if="{{pendingSessionId}}" class="home-pending-hint row">
      <text class="ellipsis">这条消息已关联到待处理会话</text>
      <text class="home-pending-open" bindtap="openPendingSession">打开会话</text>
    </view>
    <view class="home-compose-shell row">
      <textarea
        class="home-compose-input"
        value="{{quickText}}"
        placeholder="发起一条新的远程对话…"
        placeholder-style="color:#aaa7a1"
        auto-height
        maxlength="8000"
        show-confirm-bar="{{false}}"
        confirm-type="send"
        adjust-position="{{false}}"
        cursor-spacing="16"
        disabled="{{quickSending || (devices.length === 0 && devicesLoaded)}}"
        bindinput="onQuickInput"
        bindconfirm="onQuickSend"
        bindkeyboardheightchange="onComposerKeyboardChange"
      />
      <view
        class="home-compose-send {{canQuickSend ? 'home-compose-send--active' : ''}}"
        hover-class="home-compose-send--hover"
        bindtap="onQuickSend"
      >
        <text>{{quickSending ? '发送中' : pendingSubmissionUnknown ? '检查' : '发送'}}</text>
      </view>
    </view>
    <text class="home-compose-footnote">
      {{pendingSubmissionUnknown ? '结果未确认，先打开会话检查，避免重复提交' :
      '首条消息会在所选电脑上创建新会话'}}
    </text>
  </view>

  <view wx:if="{{configOpen}}" class="home-config-mask" catchtap="onCloseConfig">
    <view class="home-config-sheet" catchtap="onStopConfigTap">
      <view class="home-config-sheet-head row between">
        <view>
          <text class="home-config-sheet-title">新建会话配置</text>
          <text class="home-config-sheet-subtitle">选择只影响本次新会话</text>
        </view>
        <view class="home-config-close" hover-class="hover-dim" bindtap="onCloseConfig">完成</view>
      </view>

      <view class="home-config-row row">
        <text class="home-config-label">电脑</text>
        <picker
          class="home-config-picker grow"
          mode="selector"
          range="{{devices}}"
          range-key="pickerLabel"
          value="{{composerDeviceIndex}}"
          disabled="{{devices.length === 0 || pendingSessionId}}"
          bindchange="onConfigDeviceChange"
        >
          <view class="home-config-picker-value row between">
            <text class="ellipsis">{{composerDeviceLabel}}</text>
            <view class="icon icon-chevron-down home-config-chevron"></view>
          </view>
        </picker>
      </view>

      <view class="home-config-row row">
        <text class="home-config-label">项目</text>
        <picker
          class="home-config-picker grow"
          mode="selector"
          range="{{projectOptions}}"
          range-key="label"
          value="{{projectIndex}}"
          disabled="{{configLoading || configError || pendingSessionId}}"
          bindchange="onProjectChange"
        >
          <view class="home-config-picker-value row between">
            <text class="ellipsis">{{projectOptions[projectIndex].label}}</text>
            <view class="icon icon-chevron-down home-config-chevron"></view>
          </view>
        </picker>
      </view>

      <view class="home-config-row row">
        <text class="home-config-label">模型渠道</text>
        <picker
          class="home-config-picker grow"
          mode="selector"
          range="{{modelOptions}}"
          range-key="label"
          value="{{modelIndex}}"
          disabled="{{configLoading || configError || pendingSessionId}}"
          bindchange="onModelChange"
        >
          <view class="home-config-picker-value row between">
            <text class="ellipsis">{{modelOptions[modelIndex].label}}</text>
            <view class="icon icon-chevron-down home-config-chevron"></view>
          </view>
        </picker>
      </view>

      <view class="home-config-row row">
        <text class="home-config-label">权限模式</text>
        <picker
          class="home-config-picker grow"
          mode="selector"
          range="{{permissionOptions}}"
          range-key="label"
          value="{{permissionIndex}}"
          disabled="{{configLoading || configError || pendingSessionId}}"
          bindchange="onPermissionChange"
        >
          <view class="home-config-picker-value row between">
            <text class="ellipsis">{{permissionOptions[permissionIndex].label}}</text>
            <view class="icon icon-chevron-down home-config-chevron"></view>
          </view>
        </picker>
      </view>

      <view class="home-config-row row">
        <text class="home-config-label">推理强度</text>
        <view class="home-reasoning-control grow row">
          <view class="home-reasoning-slider-wrap grow">
            <slider
              class="home-reasoning-slider"
              min="0"
              max="{{reasoningOptions.length - 1}}"
              step="1"
              value="{{reasoningIndex}}"
              disabled="{{configLoading || configError || pendingSessionId}}"
              activeColor="#3b82f6"
              backgroundColor="#d8d5d0"
              block-size="20"
              bindchange="onReasoningChange"
            />
          </view>
          <view class="home-reasoning-value">
            <text>{{reasoningOptions[reasoningIndex].label}}</text>
          </view>
        </view>
      </view>

      <view wx:if="{{configLoading}}" class="home-config-status">正在读取这台电脑的项目和模型…</view>
      <view wx:elif="{{configError}}" class="home-config-error">
        <text>{{configError}}</text>
        <text class="home-config-retry" bindtap="onRetryConfig">重试</text>
      </view>
      <view wx:if="{{pendingSessionId}}" class="home-config-status">
        待处理会话已创建，电脑与配置已锁定，避免消息发到另一台电脑。
      </view>
    </view>
  </view>
</view>
