.home-page {
  min-height: 100vh;
  box-sizing: border-box;
  padding-bottom: calc(env(safe-area-inset-bottom) + 300rpx);
}

.home-header {
  padding-bottom: 8rpx;
}

.home-toolbar {
  height: 104rpx;
  padding: 0 32rpx;
}

.home-avatar-wrap {
  width: 84rpx;
  height: 84rpx;
  border: 1rpx solid #ececec;
  border-radius: 50%;
  overflow: hidden;
  background: #fff;
}

.home-avatar-wrap--hover {
  opacity: 0.82;
}

.home-avatar {
  width: 100%;
  height: 100%;
}

.home-avatar--fallback {
  background: #efedea;
  color: #1a1a1a;
  font-size: 34rpx;
  font-weight: 600;
}

.home-manage {
  color: #3b82f6;
  font-size: 24rpx;
}

.home-title-row {
  padding: 22rpx 32rpx 20rpx;
}

.home-title-row .page-title {
  display: block;
}

.home-subtitle {
  display: block;
  margin-top: 10rpx;
  color: #8a8782;
  font-size: 24rpx;
}

.home-section-head {
  padding: 20rpx 32rpx 12rpx;
}

.home-section-head .group-title {
  margin: 0;
}

.home-device-list {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 8rpx 32rpx 32rpx;
}

.home-device-card {
  padding: 24rpx;
  border: 1rpx solid #e9e7e4;
  border-radius: 22rpx;
  background: #fff;
  box-shadow: 0 4rpx 16rpx rgba(26, 26, 26, 0.035);
}

.home-device-card--selected {
  border-color: #c8d9f5;
}

.home-device-card--hover {
  background: #f7f6f4;
}

.home-device-heading {
  min-width: 0;
}

.home-device-name-wrap {
  min-width: 0;
}

.home-device-icon {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 66rpx;
  height: 66rpx;
  flex: none;
  border-radius: 18rpx;
  background: #f1f0ed;
}

.home-device-icon .icon-monitor {
  width: 34rpx;
  height: 34rpx;
}

.home-device-name {
  min-width: 0;
  color: #1a1a1a;
  font-size: 29rpx;
  font-weight: 600;
}

.home-device-status {
  flex: none;
  color: #77736d;
  font-size: 22rpx;
}

.home-device-dot {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #d4d1cc;
}

.home-device-dot--on {
  background: #22c55e;
}

.home-device-footer {
  margin-top: 20rpx;
  padding-left: 82rpx;
}

.home-state {
  padding: 42rpx 40rpx;
}

.home-action {
  width: fit-content;
  margin: 22rpx auto 0;
  padding: 15rpx 26rpx;
  border-radius: 999rpx;
  background: #1a1a1a;
  color: #fff;
  font-size: 24rpx;
}

.home-composer {
  position: fixed;
  z-index: 20;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 12rpx 24rpx 18rpx;
  border-top: 1rpx solid #eceae7;
  background: rgba(250, 249, 247, 0.98);
  box-sizing: border-box;
}

.home-config-trigger {
  min-height: 64rpx;
  gap: 12rpx;
  padding: 0 12rpx;
  border-radius: 14rpx;
  color: #5d5a55;
}

.home-config-trigger--hover {
  background: #efedea;
}

.home-config-tag {
  flex: none;
  color: #3b82f6;
  font-size: 22rpx;
  font-weight: 600;
}

.home-config-summary {
  min-width: 0;
  flex: 1;
  font-size: 22rpx;
}

.home-config-chevron {
  width: 32rpx;
  height: 32rpx;
  flex: none;
  background-size: 24rpx 24rpx;
}

.home-compose-shell {
  min-height: 92rpx;
  gap: 12rpx;
  padding: 12rpx 12rpx 12rpx 22rpx;
  border: 1rpx solid #e5e3df;
  border-radius: 24rpx;
  background: #fff;
  box-shadow: 0 5rpx 18rpx rgba(26, 26, 26, 0.045);
}

.home-compose-input {
  min-width: 0;
  max-height: 180rpx;
  flex: 1;
  color: #1a1a1a;
  font-size: 27rpx;
  line-height: 1.5;
}

.home-compose-send {
  min-width: 76rpx;
  height: 64rpx;
  flex: none;
  border-radius: 18rpx;
  background: #e8e6e3;
  color: #85817a;
  font-size: 22rpx;
  font-weight: 600;
  line-height: 64rpx;
  text-align: center;
}

.home-compose-send--active {
  background: #1a1a1a;
  color: #fff;
}

.home-compose-send--hover {
  opacity: 0.78;
}

.home-pending-hint {
  min-height: 52rpx;
  gap: 12rpx;
  padding: 0 8rpx;
  color: #8a5a16;
  font-size: 21rpx;
}

.home-pending-hint > text:first-child {
  min-width: 0;
  flex: 1;
}

.home-pending-open {
  flex: none;
  color: #3b82f6;
}

.home-compose-footnote {
  display: block;
  padding: 8rpx 8rpx 0;
  color: #a09c95;
  font-size: 19rpx;
}

.home-config-mask {
  position: fixed;
  z-index: 50;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: flex-end;
  background: rgba(20, 20, 20, 0.38);
}

.home-config-sheet {
  width: 100%;
  padding: 28rpx 32rpx calc(env(safe-area-inset-bottom) + 28rpx);
  border-radius: 28rpx 28rpx 0 0;
  background: #faf9f7;
  box-sizing: border-box;
}

.home-config-sheet-head {
  align-items: flex-start;
  padding-bottom: 18rpx;
}

.home-config-sheet-title,
.home-config-sheet-subtitle {
  display: block;
}

.home-config-sheet-title {
  color: #1a1a1a;
  font-size: 32rpx;
  font-weight: 600;
}

.home-config-sheet-subtitle {
  margin-top: 8rpx;
  color: #8a8782;
  font-size: 22rpx;
}

.home-config-close {
  min-width: 72rpx;
  min-height: 56rpx;
  color: #3b82f6;
  font-size: 24rpx;
  line-height: 56rpx;
  text-align: right;
}

.home-config-row {
  min-height: 88rpx;
  align-items: center;
  gap: 14rpx;
  border-top: 1rpx solid #eeece8;
}

.home-config-label {
  width: 142rpx;
  flex: none;
  color: #706d67;
  font-size: 24rpx;
}

.home-config-picker {
  min-width: 0;
}

.home-config-picker-value {
  min-height: 84rpx;
  gap: 12rpx;
  color: #252422;
  font-size: 25rpx;
}

.home-config-picker-value > text:first-child {
  min-width: 0;
  flex: 1;
  text-align: right;
}

.home-reasoning-control {
  min-width: 0;
  gap: 12rpx;
  align-items: center;
}

.home-reasoning-slider-wrap {
  display: flex;
  height: 64rpx;
  min-width: 0;
  flex: 1;
  align-items: center;
}

.home-reasoning-slider {
  width: 100%;
  height: 64rpx;
  min-width: 0;
  margin: 0;
  padding: 0;
}

.home-reasoning-value {
  width: 116rpx;
  height: 64rpx;
  flex: none;
  /* Match selector value text edges by reserving the trailing chevron and gap. */
  margin-right: 44rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  color: #252422;
  font-size: 24rpx;
  line-height: 1.2;
  text-align: right;
  white-space: nowrap;
}

.home-config-status,
.home-config-error {
  padding: 14rpx 16rpx;
  border-radius: 14rpx;
  color: #77736d;
  font-size: 22rpx;
  line-height: 1.5;
}

.home-config-status {
  background: #f0efec;
}

.home-config-error {
  background: #fff1f0;
  color: #b42318;
}

.home-config-retry {
  margin-left: 16rpx;
  color: #3b82f6;
}
