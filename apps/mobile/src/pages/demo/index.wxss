/* 界面预览页（演示数据）。浅色字面值，深色变体由 scripts/build-theme.mjs 生成。 */

.demo-page {
  padding: 24rpx 24rpx 60rpx;
  box-sizing: border-box;
}

/* ─── 顶部说明 ─────────────────────────────────────────────────────────────── */

.demo-banner {
  padding: 24rpx;
  border: 1rpx solid #e9e7e4;
  border-left: 6rpx solid #3b82f6;
  border-radius: 20rpx;
  background: #fff;
}

.demo-banner-head {
  align-items: center;
}

.demo-banner-icon {
  width: 32rpx;
  height: 32rpx;
}

.demo-banner-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
}

.demo-banner-desc {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  line-height: 1.6;
  color: #6b6b6b;
}

/* ─── 分区 ─────────────────────────────────────────────────────────────────── */

.demo-section {
  margin-top: 36rpx;
}

.demo-section-head {
  padding: 0 4rpx 12rpx;
  align-items: baseline;
}

/* ─── 电脑卡片 ─────────────────────────────────────────────────────────────── */

.demo-device {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx;
  border: 1rpx solid #e9e7e4;
  border-radius: 22rpx;
  background: #fff;
}

.demo-device-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  background: #f2f0ed;
  flex-shrink: 0;
}

.demo-device-copy {
  min-width: 0;
}

.demo-device-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #1a1a1a;
}

/* ─── 会话列表 ─────────────────────────────────────────────────────────────── */

.demo-session-list {
  border: 1rpx solid #e9e7e4;
  border-radius: 22rpx;
  background: #fff;
  overflow: hidden;
}

.demo-session {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 24rpx;
  border-bottom: 1rpx solid #f0efec;
}

.demo-session:last-child {
  border-bottom: none;
}

.demo-session--hover {
  background: #faf9f7;
}

.demo-session-main {
  min-width: 0;
}

.demo-session-title {
  font-size: 30rpx;
  color: #1a1a1a;
  max-width: 380rpx;
}

.demo-pin {
  width: 26rpx;
  height: 26rpx;
  flex-shrink: 0;
}

.demo-chevron {
  width: 26rpx;
  height: 26rpx;
  opacity: 0.45;
  flex-shrink: 0;
}

/* ─── 对话 ─────────────────────────────────────────────────────────────────── */

.demo-chat {
  display: flex;
  flex-direction: column;
  padding: 8rpx 0;
}

.demo-msg {
  margin-bottom: 22rpx;
}

.demo-msg:last-child {
  margin-bottom: 0;
}

/* 用户气泡靠右、宽度随内容；助手消息靠左（.demo-chat 是 flex column，
   否则 align-self 不生效、block 元素会撑满整行） */
.demo-msg--user {
  align-self: flex-end;
  max-width: 78%;
  padding: 18rpx 22rpx;
  border-radius: 20rpx 20rpx 6rpx 20rpx;
  background: #e9e9e7;
}

.demo-msg--assistant {
  align-self: flex-start;
  max-width: 92%;
  padding: 20rpx 22rpx;
  border: 1rpx solid #e9e7e4;
  border-radius: 6rpx 20rpx 20rpx 20rpx;
  background: #fff;
}

.demo-msg-text {
  display: block;
  font-size: 28rpx;
  line-height: 1.65;
  color: #1a1a1a;
  white-space: pre-wrap;
  word-break: break-word;
}

.demo-msg-tail {
  margin-top: 12rpx;
}

.demo-code {
  margin-top: 14rpx;
  padding: 16rpx 18rpx;
  border-radius: 14rpx;
  background: #f2f0ed;
}

.demo-code-text {
  font-family: 'SF Mono', Menlo, Consolas, monospace;
  font-size: 24rpx;
  line-height: 1.55;
  color: #3f3d39;
  white-space: pre-wrap;
  word-break: break-all;
}

.demo-tool {
  display: flex;
  align-items: center;
  gap: 10rpx;
  margin-top: 14rpx;
  padding: 12rpx 16rpx;
  border-radius: 12rpx;
  background: #faf9f7;
  border: 1rpx solid #f0efec;
}

.demo-tool-icon {
  width: 26rpx;
  height: 26rpx;
  flex-shrink: 0;
}

.demo-tool-text {
  font-size: 24rpx;
  color: #6b6b6b;
}

/* ─── 假输入框 ─────────────────────────────────────────────────────────────── */

.demo-composer {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 10rpx;
  padding: 18rpx 18rpx 18rpx 24rpx;
  border: 1rpx solid #e9e7e4;
  border-radius: 999rpx;
  background: #fff;
}

.demo-composer-placeholder {
  flex: 1;
  font-size: 28rpx;
  color: #8a8782;
}

.demo-composer-send {
  width: 60rpx;
  height: 60rpx;
  border-radius: 999rpx;
  background: #3b82f6;
  flex-shrink: 0;
}

/* ─── 底部 ─────────────────────────────────────────────────────────────────── */

.demo-foot {
  margin-top: 40rpx;
}

.demo-foot-tip {
  display: block;
  margin-bottom: 20rpx;
  line-height: 1.6;
  color: #6b6b6b;
}

/* 自绘图标改了 width/height 后必须同步 background-size，否则 40rpx 的底图会溢出 */
.demo-banner-icon {
  background-size: 32rpx 32rpx;
}

.demo-pin,
.demo-chevron,
.demo-tool-icon {
  background-size: 26rpx 26rpx;
}
