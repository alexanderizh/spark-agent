/* 对话页布局：导航 + 弹性消息区 + 停靠输入（flex column 撑满视口） */

.chat-page {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background: #f7f6f4;
  box-sizing: border-box;
}

.chat-scroll {
  flex: 1;
  min-height: 0;
}

.chat-body {
  padding: 24rpx 32rpx 24rpx;
}

.chat-anchor {
  height: 8rpx;
}

/* 天级时间分界 */
.chat-time {
  text-align: center;
  font-size: 22rpx;
  color: #b3b0ab;
  margin: 24rpx 0;
}

/* ─── 消息行 ───────────────────────────────────────────────────────────────── */

.msg-row {
  margin: 16rpx 0;
}

.msg-row--user {
  display: flex;
  justify-content: flex-end;
}

/* 用户气泡：右侧浅灰圆角 */
.bubble-user {
  max-width: 78%;
  background: #e9e9e7;
  border-radius: 32rpx;
  border-bottom-right-radius: 12rpx;
  padding: 20rpx 28rpx;
  font-size: 30rpx;
  line-height: 1.6;
  color: #1a1a1a;
  word-break: break-all;
}

/* AI 回复：全宽无气泡 */
.msg-row--assistant {
  padding: 4rpx 0;
}

/* 打字指示（AI 回复为空时） */
.chat-typing {
  padding: 8rpx 0;
}
.typing-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #c9c6c0;
  animation: typing-bounce 1.2s infinite ease-in-out;
}
.typing-dot--2 {
  animation-delay: 0.15s;
}
.typing-dot--3 {
  animation-delay: 0.3s;
}
@keyframes typing-bounce {
  0%,
  60%,
  100% {
    transform: translateY(0);
    opacity: 0.5;
  }
  30% {
    transform: translateY(-8rpx);
    opacity: 1;
  }
}

/* ─── 工具调用行 ───────────────────────────────────────────────────────────── */

.tool-line {
  padding: 10rpx 0 10rpx 4rpx;
  gap: 12rpx;
}
.tool-name {
  color: #6b6b6b;
  max-width: 60%;
}
.tool-status {
  font-size: 22rpx;
  color: #b3b0ab;
  flex: none;
}

/* ─── 状态行 ───────────────────────────────────────────────────────────────── */

.status-line {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 12rpx;
  padding: 10rpx 4rpx;
  color: #8e8e8e;
}
.status-line--error {
  color: #dc2626;
}
.status-line--error .t-caption {
  color: #dc2626;
}

.status-spinner {
  width: 20rpx;
  height: 20rpx;
  border-radius: 50%;
  border: 3rpx solid #d7d4cf;
  border-top-color: #1a1a1a;
  animation: spin 0.8s linear infinite;
  flex: none;
}
@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

/* ─── 底部停靠输入 ─────────────────────────────────────────────────────────── */

.chat-dock {
  flex: none;
  background: #f7f6f4;
}
