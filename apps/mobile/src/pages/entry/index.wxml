<view class="entry-page">
  <view class="entry-brand">
    <image class="entry-logo" src="/assets/brand/logo.png" mode="aspectFit" />
    <text class="entry-name">SparkWork</text>
    <text class="entry-hint">{{hint}}</text>
  </view>
  <view wx:if="{{failed}}" class="entry-retry" hover-class="entry-retry--hover" bindtap="go">
    <text>重试</text>
  </view>
</view>
