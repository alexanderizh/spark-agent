.profile-page {
  padding: 24rpx 24rpx 48rpx;
}

/* ─── 用户卡片 ─────────────────────────────────────────────────────────────── */

.user-card {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 24rpx;
}

.avatar-wrap {
  position: relative;
  flex: none;
}
.avatar-large {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  flex: none;
  display: block;
}
.avatar-placeholder {
  background: #3b82f6;
  display: flex;
  align-items: center;
  justify-content: center;
}
.avatar-text {
  color: #fff;
  font-size: 44rpx;
  font-weight: 600;
}
.avatar-badge {
  position: absolute;
  right: -4rpx;
  bottom: -4rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #fff;
  border: 1rpx solid #ececec;
  box-shadow: 0 2rpx 8rpx rgba(26, 26, 26, 0.08);
  display: flex;
  align-items: center;
  justify-content: center;
}
.avatar-badge-icon {
  width: 22rpx;
  height: 22rpx;
  background-repeat: no-repeat;
  background-position: center;
  background-size: 22rpx 22rpx;
}
.avatar-loading {
  position: absolute;
  inset: 0;
  border-radius: 50%;
  background: rgba(17, 16, 14, 0.5);
  color: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}

/* 昵称旁「编辑」描边小胶囊 */
.edit-chip {
  font-size: 22rpx;
  color: #6b6b6b;
  border: 1rpx solid #e5e2dd;
  border-radius: 999rpx;
  padding: 4rpx 20rpx;
  line-height: 1.5;
  flex: none;
}
.edit-chip--hover {
  background: #f2f1ef;
}

/* ─── hover ────────────────────────────────────────────────────────────────── */

.btn-danger-plain--hover {
  background: #fef2f2;
}
