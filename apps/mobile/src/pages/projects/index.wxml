<view class="projects-page theme-root {{themeClass}}">
  <!-- 状态栏遮罩：内容滚到顶部时被它挡住，不会从系统状态栏下面穿过去 -->
  <view class="projects-status-scrim" style="height: {{stickyTop}}px"></view>

  <!-- tabBar 页：不挂返回按钮（返回工作台走底部 tab） -->
  <safe-nav-bar title="" show-back="{{false}}" />

  <view class="projects-heading row between">
    <view class="grow">
      <text class="page-title">项目</text>
      <text class="projects-subtitle">先选电脑，再浏览它自己的项目</text>
    </view>
    <view class="projects-manage" bindtap="onOpenBridgeDevices">设备管理</view>
  </view>

  <!-- 当前电脑：点整行就地切换（备注名优先，原名降级为副标题） -->
  <view
    wx:if="{{!deviceMissing}}"
    class="projects-device-context row"
    hover-class="projects-device-context--hover"
    bindtap="onOpenDeviceSwitch"
  >
    <view class="projects-device-dot {{deviceOffline ? '' : 'projects-device-dot--on'}}"></view>
    <view class="grow projects-context-main">
      <view class="row projects-context-name-line">
        <text class="projects-context-name ellipsis">{{deviceName}}</text>
        <view class="icon icon-chevron-down projects-context-caret"></view>
      </view>
      <text wx:if="{{deviceRealName}}" class="projects-context-real ellipsis">{{deviceRealName}}</text>
      <text wx:else class="projects-context-label">当前电脑 · 点此切换</text>
    </view>
    <view class="projects-switch" catchtap="onBackToComputers">返回电脑列表</view>
  </view>

  <!-- 吸顶哨兵：越过状态栏下沿即代表下面这块搜索/筛选区已贴顶 -->
  <view class="projects-sticky-anchor" id="projects-sticky-sentinel"></view>

  <!-- 搜索 + 筛选（吸顶：标题与电脑上下文滚走后仍可随时改条件） -->
  <view
    wx:if="{{!deviceMissing && !loading && !deviceUnavailable && !deviceOffline && !errorText}}"
    class="projects-sticky {{stickyStuck ? 'projects-sticky--stuck' : ''}}"
    style="top: {{stickyTop}}px"
  >
    <!-- 项目搜索（桌面端同款标题过滤；与筛选/置顶/手动排序叠加生效） -->
    <view class="projects-search row">
      <view class="icon icon-sm icon-search"></view>
      <input
        class="projects-search-input"
        value="{{searchText}}"
        placeholder="搜索项目"
        placeholder-class="themed-placeholder"
        confirm-type="search"
        bindinput="onSearchInput"
      />
    </view>

    <!-- 筛选 + 全部会话入口 -->
    <view class="projects-toolbar row between">
      <view
        class="projects-filter-chip {{filterActiveCount > 0 ? 'projects-filter-chip--on' : ''}}"
        hover-class="projects-filter-chip--hover"
        bindtap="onOpenFilter"
      >
        <text class="projects-filter-text ellipsis">{{filterSummary}}</text>
        <view class="icon icon-chevron-down projects-filter-caret"></view>
      </view>
      <view class="projects-all-link" hover-class="hover-dim" bindtap="onOpenAllSessions">
        <text>全部会话</text>
        <view class="icon icon-chevron projects-all-caret"></view>
      </view>
    </view>
  </view>

  <view wx:if="{{deviceMissing}}" class="projects-state">
    <empty-state
      icon="monitor"
      title="还没有选择电脑"
      desc="先在「工作台」点一台已接入的电脑，再回来浏览它的项目与会话。"
    />
    <view class="projects-action" bindtap="onBackToComputers">去工作台选电脑</view>
  </view>

  <view wx:elif="{{loading}}" class="loading-tip">正在加载这台电脑的项目…</view>

  <view wx:elif="{{deviceUnavailable}}" class="projects-state">
    <empty-state icon="monitor" title="这台电脑已被吊销" desc="返回电脑列表，选择其他已接入的电脑" />
    <view class="projects-action" bindtap="onBackToComputers">返回电脑列表</view>
  </view>

  <view wx:elif="{{deviceOffline}}" class="projects-state">
    <empty-state icon="monitor" title="这台电脑当前离线" desc="项目只从所选电脑读取。电脑重新连上中继后，可在这里继续查看。" />
    <view class="projects-action" bindtap="onBackToComputers">返回电脑列表</view>
  </view>

  <view wx:elif="{{errorText}}" class="projects-state">
    <empty-state icon="monitor" title="项目加载失败" desc="{{errorText}}" />
    <view class="projects-action" bindtap="onRetry">重试</view>
  </view>

  <block wx:else>
    <view wx:if="{{projects.length === 0}}" class="projects-state">
      <empty-state icon="folder" title="这台电脑还没有项目" desc="请先在桌面端打开一个项目；其会话会归入该项目。" />
    </view>

    <view wx:elif="{{pinnedView.length === 0 && normalView.length === 0}}" class="projects-state">
      <empty-state
        icon="folder"
        title="{{filterActiveCount > 0 ? '没有符合筛选的项目' : '没有匹配的项目'}}"
        desc="{{filterActiveCount > 0 ? '换个时间范围，或清除筛选后再看' : '换个关键词试试'}}"
      />
      <view wx:if="{{filterActiveCount > 0}}" class="projects-action" bindtap="onFilterReset">清除筛选</view>
    </view>

    <view wx:else class="projects-list">
      <!-- 置顶段（长按可取消置顶/调序） -->
      <block wx:if="{{pinnedView.length > 0}}">
        <text class="group-title">置顶</text>
        <view
          wx:for="{{pinnedView}}"
          wx:key="id"
          class="projects-row row"
          hover-class="projects-row--hover"
          data-id="{{item.id}}"
          data-name="{{item.name}}"
          bindtap="onOpenProject"
          bindlongpress="onProjectLongPress"
        >
          <view class="icon icon-folder projects-row-icon"></view>
          <view class="grow col gap-4 projects-row-copy">
            <view class="row projects-row-name-line">
              <text class="projects-row-name ellipsis grow">{{item.name}}</text>
            </view>
            <view class="row projects-row-meta">
              <text class="t-caption">{{item.sessionCount}} 条会话</text>
              <view wx:if="{{item.runningSessionCount > 0}}" class="row projects-running-badge">
                <view class="projects-running-dot"></view>
                <text>运行中</text>
              </view>
              <text wx:if="{{item.updatedLabel}}" class="t-caption projects-row-time">{{item.updatedLabel}}</text>
            </view>
          </view>
          <!-- 置顶标记放在行级操作区，与「＋ / chevron」同轴心对齐（放进标题行会因两行文字而偏上） -->
          <view class="projects-row-pin-slot">
            <view class="icon icon-pin projects-row-pin"></view>
          </view>
          <view
            class="projects-row-add"
            hover-class="projects-row-add--hover"
            data-id="{{item.id}}"
            data-name="{{item.name}}"
            catchtap="onCreateSessionInProject"
          >
            <view class="icon icon-sm icon-plus"></view>
          </view>
          <view class="icon icon-chevron"></view>
        </view>
      </block>

      <!-- 普通段（虚拟「未归属项目」恒在末尾，不参与排序） -->
      <block wx:if="{{normalView.length > 0}}">
        <text class="group-title">项目</text>
        <view
          wx:for="{{normalView}}"
          wx:key="id"
          class="projects-row row"
          hover-class="projects-row--hover"
          data-id="{{item.id}}"
          data-name="{{item.name}}"
          bindtap="onOpenProject"
          bindlongpress="onProjectLongPress"
        >
          <view class="icon {{item.isVirtual ? 'icon-chat' : 'icon-folder'}} projects-row-icon"></view>
          <view class="grow col gap-4 projects-row-copy">
            <text class="projects-row-name ellipsis">{{item.name}}</text>
            <view class="row projects-row-meta">
              <text class="t-caption">{{item.sessionCount}} 条会话</text>
              <view wx:if="{{item.runningSessionCount > 0}}" class="row projects-running-badge">
                <view class="projects-running-dot"></view>
                <text>运行中</text>
              </view>
              <text wx:if="{{item.updatedLabel}}" class="t-caption projects-row-time">{{item.updatedLabel}}</text>
            </view>
          </view>
          <!-- 同宽空槽位：普通段没有图钉也要占位，两段行的「＋ / chevron」才落在同一竖列 -->
          <view class="projects-row-pin-slot"></view>
          <view
            class="projects-row-add"
            hover-class="projects-row-add--hover"
            data-id="{{item.id}}"
            data-name="{{item.name}}"
            catchtap="onCreateSessionInProject"
          >
            <view class="icon icon-sm icon-plus"></view>
          </view>
          <view class="icon icon-chevron"></view>
        </view>
      </block>
    </view>
  </block>

  <!-- 切换电脑：单选即生效；离线设备也可选，切过去显示离线态并由 presence 自动恢复 -->
  <sheet-panel
    show="{{deviceSheetShow}}"
    title="切换电脑"
    mode="list"
    options="{{deviceOptions}}"
    loading="{{deviceOptionsLoading}}"
    emptyText="还没有已接入的电脑"
    bind:close="onCloseDeviceSheet"
    bind:select="onDeviceSelect"
  />

  <!-- 项目筛选（时间 + 状态，单选；点已选项 = 取消该维度） -->
  <filter-sheet
    show="{{filterShow}}"
    title="筛选项目"
    sections="{{filterSections}}"
    activeCount="{{filterActiveCount}}"
    resultText="{{visibleCount}} 个项目"
    bind:close="onCloseFilter"
    bind:toggle="onFilterToggle"
    bind:reset="onFilterReset"
  />
</view>
