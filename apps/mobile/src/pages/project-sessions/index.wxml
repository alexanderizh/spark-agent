<!-- 固定电脑下的项目/全部会话列表：大标题 + 电脑上下文 + 筛选 + 分组条目 -->

<view class="ps-page">
  <safe-nav-bar title="" />

  <!-- 当前项目 -->
  <view class="ps-title-row">
    <text class="page-title ellipsis">{{projectName}}</text>
    <view class="ps-title-action" bindtap="onOpenBridgeDevices">授信设备</view>
  </view>

  <!-- 电脑是上层上下文；此处只显示归属，返回顶层后才能切换 -->
  <view class="ps-device-context">
    <view class="ps-context-dot {{deviceOffline ? '' : 'ps-context-dot--on'}}"></view>
    <text class="ps-context-label">电脑</text>
    <text class="ps-context-name ellipsis">{{deviceName}}</text>
    <text class="ps-context-action" bindtap="onBackToProjects">返回项目 ›</text>
  </view>

  <!-- 筛选 + 搜索行 -->
  <view class="ps-controls">
    <view class="ps-segments">
      <view
        wx:for="{{['all','running','error']}}"
        wx:key="*this"
        class="ps-segment {{filter === item ? 'ps-segment--active' : ''}}"
        data-filter="{{item}}"
        bindtap="onFilterChange"
      >{{item === 'all' ? '全部' : (item === 'running' ? '进行中' : '异常')}}</view>
      <view
        class="ps-segment {{labelFilter !== '' ? 'ps-segment--accent' : ''}}"
        bindtap="onOpenLabelFilterPanel"
      >{{labelFilterText}}</view>
    </view>
    <view class="ps-search row">
      <view class="icon icon-sm icon-search"></view>
      <input
        class="ps-search-input"
        value="{{searchText}}"
        placeholder="搜索会话"
        placeholder-style="color:#b3b0ab"
        confirm-type="search"
        focus="{{autoFocusSearch}}"
        bindinput="onSearchInput"
      />
    </view>
  </view>

  <!-- 固定电脑下的会话列表 -->
  <view wx:if="{{loading}}" class="loading-tip">加载中…</view>

  <view wx:elif="{{deviceUnavailable}}" class="ps-error">
    <empty-state icon="monitor" title="这台电脑已解除授信" desc="返回项目列表，或回到电脑顶层重新选择" />
    <view class="ps-back-button" bindtap="onBackToProjects">返回项目列表</view>
  </view>

  <view wx:elif="{{deviceOffline}}" class="ps-error">
    <empty-state icon="monitor" title="这台电脑当前离线" desc="电脑重新连上中继后，可回到项目列表继续查看" />
    <view class="ps-back-button" bindtap="onBackToProjects">返回项目列表</view>
  </view>

  <view wx:elif="{{errorText}}" class="ps-error">
    <empty-state icon="monitor" title="加载失败" desc="{{errorText}}" />
  </view>

  <block wx:else>
    <view wx:if="{{groups.length === 0 && contentMatches.length === 0}}" class="ps-empty">
      <empty-state
        icon="chat"
        title="{{searchText ? '没有匹配的会话' : '项目下还没有会话'}}"
        desc="{{searchText ? '换个关键词试试' : '在下方输入框发起第一条对话'}}"
      />
    </view>

    <block wx:else>
      <view wx:for="{{groups}}" wx:for-item="group" wx:key="key" class="ps-group">
        <view class="group-title">{{group.label}}</view>
        <view
          wx:for="{{group.rows}}"
          wx:key="id"
          class="list-row"
          hover-class="list-row--hover"
          data-id="{{item.id}}"
          data-title="{{item.title}}"
          data-pinned="{{item.pinnedAt != null}}"
          bindtap="onOpenSession"
          bindlongpress="onRowLongPress"
        >
          <view class="dot {{item.dotClass}}"></view>
          <view class="grow col gap-8 ps-row-text">
            <view class="row ps-row-title-line">
              <text class="t-strong ellipsis grow">{{item.title}}</text>
              <view wx:if="{{item.labelText}}" class="ps-label-tag {{item.labelClass}}">{{item.labelText}}</view>
            </view>
            <text class="t-caption ellipsis">{{item.statusLabel}} · {{item.timeLabel}}{{item.preview ? ' · ' + item.preview : ''}}</text>
          </view>
          <view class="icon icon-chevron"></view>
        </view>
      </view>

      <!-- 内容匹配（服务器 FTS5 搜索正文；与上方标题匹配去重，仅搜索时出现） -->
      <view wx:if="{{contentMatches.length > 0}}" class="ps-group">
        <view class="group-title">内容匹配</view>
        <view
          wx:for="{{contentMatches}}"
          wx:key="sessionId"
          class="list-row"
          hover-class="list-row--hover"
          data-id="{{item.sessionId}}"
          data-title="{{item.title}}"
          bindtap="onOpenSession"
        >
          <view class="ps-match-icon icon icon-sm icon-search"></view>
          <view class="grow col gap-8 ps-row-text">
            <view class="row ps-row-title-line">
              <text class="t-strong ellipsis grow">{{item.title}}</text>
              <view wx:if="{{item.labelText}}" class="ps-label-tag {{item.labelClass}}">{{item.labelText}}</view>
            </view>
            <text class="ps-match-snippet">{{item.snippet}}</text>
            <text class="t-caption ellipsis">{{item.statusLabel ? item.statusLabel + ' · ' : ''}}{{item.timeLabel}}</text>
          </view>
          <view class="icon icon-chevron"></view>
        </view>
      </view>
    </block>
  </block>

  <view class="ps-spacer"></view>

  <!-- 悬浮胶囊：当前项目发起新会话（配置 chips 与会话页同构：模型/权限快捷行 + 推理配置条） -->
  <capsule-composer
    mode="float"
    value="{{quickText}}"
    placeholder="{{projectId === 'default' ? '在未归属项目中发起对话…' : '在 ' + (projectName || '项目') + ' 发起对话…'}}"
    disabled="{{quickSending || deviceOffline || deviceUnavailable}}"
    chips="{{chips}}"
    bind:input="onQuickInput"
    bind:send="onQuickSend"
    bind:chip="onChipTap"
  />
</view>

<!-- 新会话配置面板（模型/权限/推理，与会话页共用 sheet-panel） -->
<sheet-panel
  show="{{panelShow}}"
  title="{{panelTitle}}"
  mode="{{panelMode}}"
  options="{{panelOptions}}"
  loading="{{panelLoading}}"
  emptyText="{{panelEmpty}}"
  sliderOptions="{{panelSliderLabels}}"
  sliderIndex="{{panelSliderIndex}}"
  bind:close="closePanel"
  bind:select="onPanelSelect"
  bind:sliderchange="onPanelSliderChange"
/>
