<!-- 项目/全部会话列表：大标题 + 电脑切换条 + 筛选 + 分组两行式条目 + 悬浮胶囊 -->

<view class="ps-page">
  <safe-nav-bar title="" />

  <!-- 大标题（项目名 / 全部会话） -->
  <view class="ps-title-row">
    <text class="page-title ellipsis">{{allMode ? '全部会话' : projectName}}</text>
    <view class="ps-title-action" bindtap="onOpenBridgeDevices">授信设备</view>
  </view>

  <!-- 电脑切换条：横向滚动设备 pill（设备名 + 在线圆点；离线可选中） -->
  <view wx:if="{{devices.length > 0}}" class="ps-devices">
    <scroll-view class="ps-devices-scroll" scroll-x>
      <view class="ps-devices-row">
        <view
          class="ps-pill {{selectedDeviceId === '' ? 'ps-pill--active' : ''}}"
          hover-class="ps-pill--hover"
          bindtap="onPickPrimaryDevice"
        >
          <view class="ps-pill-dot {{primaryOnline ? 'ps-pill-dot--on' : ''}}"></view>
          <text class="ps-pill-name">自动</text>
        </view>
        <view
          wx:for="{{devices}}"
          wx:key="deviceId"
          class="ps-pill {{selectedDeviceId === item.deviceId ? 'ps-pill--active' : ''}}"
          hover-class="ps-pill--hover"
          data-id="{{item.deviceId}}"
          bindtap="onPickDevice"
        >
          <view class="ps-pill-dot {{item.online ? 'ps-pill-dot--on' : ''}}"></view>
          <text class="ps-pill-name">{{item.name}}</text>
        </view>
      </view>
    </scroll-view>
  </view>

  <!-- 筛选 + 搜索行 -->
  <view class="ps-controls">
    <view class="ps-segments">
      <view
        wx:for="{{['all','running','error']}}"
        wx:key="*this"
        class="ps-segment {{filter === item ? 'ps-segment--active' : ''}}"
        data-filter="{{item}}"
        bindtap="onFilterChange"
      >{{item === 'all' ? '全部' : (item === 'running' ? '进行中' : '异常')}}</view>
    </view>
    <view class="ps-search row">
      <view class="icon icon-sm icon-search"></view>
      <input
        class="ps-search-input"
        value="{{searchText}}"
        placeholder="搜索会话"
        placeholder-style="color:#b3b0ab"
        confirm-type="search"
        focus="{{autoFocusSearch}}"
        bindinput="onSearchInput"
      />
    </view>
  </view>

  <!-- 列表 -->
  <view wx:if="{{loading}}" class="loading-tip">加载中…</view>

  <view wx:elif="{{errorText}}" class="ps-error">
    <empty-state icon="monitor" title="加载失败" desc="{{errorText}}" />
  </view>

  <!-- 无授信设备：引导在桌面端登录同一账号并开启中继 -->
  <view wx:elif="{{devicesLoaded && devices.length === 0}}" class="ps-empty">
    <empty-state
      icon="monitor"
      title="还没有授信电脑"
      desc="在电脑端 SparkWork 用同一 Spark 平台账号登录，并开启「设置 → 生态 → 移动端桥接 → 云端中继」，首次连接后自动授信"
    />
  </view>

  <block wx:else>
    <!-- 所选电脑离线：不发请求，列表区显示提示条 -->
    <view wx:if="{{selectedOffline}}" class="ps-offline">
      <view class="ps-offline-dot"></view>
      <text>该电脑离线，请在桌面端开启远程会话（云端中继）</text>
    </view>

    <view wx:elif="{{groups.length === 0}}" class="ps-empty">
      <empty-state
        icon="chat"
        title="{{searchText ? '没有匹配的会话' : '项目下还没有会话'}}"
        desc="{{searchText ? '换个关键词试试' : '在下方输入框发起第一条对话'}}"
      />
    </view>

    <block wx:else>
      <view wx:for="{{groups}}" wx:for-item="group" wx:key="key" class="ps-group">
        <view class="group-title">{{group.label}}</view>
        <view
          wx:for="{{group.rows}}"
          wx:key="id"
          class="list-row"
          hover-class="list-row--hover"
          data-id="{{item.id}}"
          data-title="{{item.title}}"
          data-pinned="{{item.pinnedAt != null}}"
          bindtap="onOpenSession"
          bindlongpress="onRowLongPress"
        >
          <view class="dot {{item.dotClass}}"></view>
          <view class="grow col gap-8 ps-row-text">
            <text class="t-strong ellipsis">{{item.title}}</text>
            <text class="t-caption ellipsis">{{item.statusLabel}} · {{item.timeLabel}}{{item.preview ? ' · ' + item.preview : ''}}</text>
          </view>
          <view class="icon icon-chevron"></view>
        </view>
      </view>
    </block>
  </block>

  <view class="ps-spacer"></view>

  <!-- 悬浮胶囊：当前项目发起新会话 -->
  <capsule-composer
    mode="float"
    value="{{quickText}}"
    placeholder="{{allMode ? '发起新对话…' : '在 ' + (projectName || '项目') + ' 发起对话…'}}"
    disabled="{{quickSending}}"
    bind:input="onQuickInput"
    bind:send="onQuickSend"
  />
</view>
