/* 项目会话列表页：大标题 + 分组条目 + 悬浮胶囊（Cursor 工作区列表式） */

.ps-page {
  min-height: 100vh;
  box-sizing: border-box;
}

.ps-title-row {
  padding: 16rpx 32rpx 8rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.ps-title-row .page-title {
  display: block;
  flex: 1;
  min-width: 0;
}
.ps-title-action {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #3b82f6;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: #eef4fe;
}

.ps-title-action:active {
  opacity: 0.7;
}

/* ─── 电脑上下文（切换需返回顶层） ──────────────────────────────────────────── */

.ps-device-context {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 0 32rpx 8rpx;
  min-height: 64rpx;
  padding: 8rpx 16rpx;
  border: 1rpx solid #ececec;
  border-radius: 12rpx;
  background: #fff;
}
.ps-context-dot {
  flex: none;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #d97706;
}
.ps-context-dot--on {
  background: #22c55e;
}
.ps-context-label {
  flex: none;
  font-size: 22rpx;
  color: #8a8782;
}
.ps-context-name {
  flex: 1;
  min-width: 0;
  color: #1a1a1a;
  font-size: 25rpx;
  font-weight: 500;
}
.ps-context-action {
  flex: none;
  color: #3b82f6;
  font-size: 22rpx;
  padding: 12rpx 0 12rpx 8rpx;
}
.ps-context-action:active {
  background: #f7f6f4;
}

.ps-back-button {
  display: flex;
  justify-content: center;
  width: 240rpx;
  margin: 24rpx auto 0;
  padding: 16rpx 24rpx;
  box-sizing: border-box;
  border-radius: 999rpx;
  background: #1a1a1a;
  color: #fff;
  font-size: 24rpx;
}

/* ─── 筛选 + 搜索 ──────────────────────────────────────────────────────────── */

.ps-controls {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 16rpx 32rpx 8rpx;
}

.ps-segments {
  display: flex;
  flex-direction: row;
  gap: 12rpx;
}
.ps-segment {
  padding: 10rpx 26rpx;
  border-radius: 999rpx;
  background: #efedea;
  font-size: 24rpx;
  color: #6b6b6b;
}
.ps-segment--active {
  background: #1a1a1a;
  color: #fff;
  font-weight: 500;
}
/* 标记筛选 chip 命中时用琥珀描边（与置顶语义同色系，不与状态筛选混淆） */
.ps-segment--accent {
  background: #fdf3e3;
  color: #b45309;
  font-weight: 500;
}

.ps-search {
  background: #fff;
  border: 1rpx solid #ececec;
  border-radius: 999rpx;
  padding: 14rpx 24rpx;
  gap: 12rpx;
}
.ps-search-input {
  flex: 1;
  font-size: 28rpx;
  color: #1a1a1a;
}

/* ─── 分组列表 ─────────────────────────────────────────────────────────────── */

.ps-group {
  padding: 24rpx 32rpx 8rpx;
}
.ps-group .group-title {
  display: block;
  margin-bottom: 8rpx;
}
.ps-row-text {
  margin: 0 20rpx;
}
.ps-row-title-line {
  align-items: center;
  gap: 12rpx;
  min-width: 0;
}
.list-row--hover {
  background: #f2f1ef;
}

/* ─── 会话标记标签（5 预置色，与桌面端 session-labels.less 浅色变量同族） ────── */

.ps-label-tag {
  flex: none;
  padding: 2rpx 12rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  line-height: 30rpx;
}
.ps-label-tag.label-suspended {
  background: #fef3c7;
  color: #b45309;
}
.ps-label-tag.label-not-started {
  background: #f3f4f6;
  color: #6b7280;
}
.ps-label-tag.label-pending-review {
  background: #ede9fe;
  color: #7c3aed;
}
.ps-label-tag.label-pending-advance {
  background: #cffafe;
  color: #0e7490;
}
.ps-label-tag.label-undelivered {
  background: #ffe4e6;
  color: #e11d48;
}

.ps-error,
.ps-empty {
  padding: 48rpx 40rpx;
}

/* ─── 底部占位（悬浮胶囊含快捷行/配置条，高度留足） ────────────────────────── */

.ps-spacer {
  height: calc(env(safe-area-inset-bottom) + 340rpx);
}

/* ─── 内容匹配段（服务器 FTS5 搜索正文命中） ───────────────────────────────── */

.ps-match-icon {
  width: 32rpx;
  height: 32rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
  color: #b3b0ab;
}

/* 片段最多两行，超出省略（snippet 可能较长，单行 ellipsis 会截掉关键命中） */
.ps-match-snippet {
  font-size: 24rpx;
  line-height: 34rpx;
  color: #6b6862;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  word-break: break-all;
}
