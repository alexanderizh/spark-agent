/* 项目会话列表页：大标题 + 分组条目 + 悬浮胶囊（Cursor 工作区列表式） */

.ps-page {
  min-height: 100vh;
  box-sizing: border-box;
}

.ps-title-row {
  padding: 16rpx 32rpx 8rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
}
.ps-title-row .page-title {
  display: block;
  flex: 1;
  min-width: 0;
}
.ps-title-action {
  flex-shrink: 0;
  font-size: 24rpx;
  color: #3b82f6;
  padding: 8rpx 20rpx;
  border-radius: 999rpx;
  background: #eef4fe;
}

.ps-title-action:active {
  opacity: 0.7;
}

/* ─── 电脑切换条（横向滚动设备 pill） ───────────────────────────────────────── */

.ps-devices {
  padding: 8rpx 32rpx 0;
}

.ps-devices-scroll {
  width: 100%;
  white-space: nowrap;
}

.ps-devices-row {
  display: inline-flex;
  flex-direction: row;
  gap: 12rpx;
  padding: 8rpx 0;
}

.ps-pill {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  flex-shrink: 0;
  padding: 10rpx 24rpx;
  border-radius: 999rpx;
  background: #ffffff;
  border: 1rpx solid #ececec;
  max-width: 320rpx;
  box-sizing: border-box;
}

.ps-pill--hover {
  background: #f2f1ef;
}

.ps-pill--active {
  background: #1a1a1a;
  border-color: #1a1a1a;
}

.ps-pill--active .ps-pill-name {
  color: #ffffff;
}

.ps-pill-name {
  font-size: 24rpx;
  color: #6b6b6b;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.ps-pill-dot {
  flex-shrink: 0;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #d4d1cc;
}

.ps-pill-dot--on {
  background: #22c55e;
}

/* ─── 所选电脑离线提示条 ───────────────────────────────────────────────────── */

.ps-offline {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 16rpx 32rpx 0;
  padding: 18rpx 24rpx;
  border-radius: 16rpx;
  background: #fdf6ec;
  border: 1rpx solid #f5e5c8;
  font-size: 24rpx;
  color: #b45309;
  line-height: 1.5;
}

.ps-offline-dot {
  flex-shrink: 0;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #d97706;
}

/* ─── 筛选 + 搜索 ──────────────────────────────────────────────────────────── */

.ps-controls {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  padding: 16rpx 32rpx 8rpx;
}

.ps-segments {
  display: flex;
  flex-direction: row;
  gap: 12rpx;
}
.ps-segment {
  padding: 10rpx 26rpx;
  border-radius: 999rpx;
  background: #efedea;
  font-size: 24rpx;
  color: #6b6b6b;
}
.ps-segment--active {
  background: #1a1a1a;
  color: #fff;
  font-weight: 500;
}

.ps-search {
  background: #fff;
  border: 1rpx solid #ececec;
  border-radius: 999rpx;
  padding: 14rpx 24rpx;
  gap: 12rpx;
}
.ps-search-input {
  flex: 1;
  font-size: 28rpx;
  color: #1a1a1a;
}

/* ─── 分组列表 ─────────────────────────────────────────────────────────────── */

.ps-group {
  padding: 24rpx 32rpx 8rpx;
}
.ps-group .group-title {
  display: block;
  margin-bottom: 8rpx;
}
.ps-row-text {
  margin: 0 20rpx;
}
.list-row--hover {
  background: #f2f1ef;
}

.ps-error,
.ps-empty {
  padding: 48rpx 40rpx;
}

/* ─── 底部占位 ─────────────────────────────────────────────────────────────── */

.ps-spacer {
  height: calc(env(safe-area-inset-bottom) + 200rpx);
}
