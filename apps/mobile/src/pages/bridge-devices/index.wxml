<!-- 设备管理：列表卡片 + 在线徽标 + 行内二次确认吊销 -->

<view class="bd-page">
  <safe-nav-bar title="设备管理" />

  <view class="bd-title-row">
    <text class="page-title">设备管理</text>
  </view>

  <view class="bd-lede">
    通过云端中继访问你会话的桌面设备。电脑首次连接会自动注册接入；<text class="bd-lede-strong">吊销后立即断开且不可恢复</text>，需要恢复时在桌面端「重置设备身份」。
  </view>

  <view wx:if="{{loading}}" class="loading-tip">加载中…</view>

  <view wx:elif="{{errorText}}" class="bd-error">
    <empty-state icon="monitor" title="加载失败" desc="{{errorText}}" />
  </view>

  <view wx:elif="{{devices.length === 0}}" class="bd-empty">
    <empty-state
      icon="monitor"
      title="还没有接入的设备"
      desc="在电脑端 SparkWork 打开「设置 → 生态 → 移动端桥接 → 云端中继」，用同一 Spark 平台账号登录后即自动注册接入"
    />
  </view>

  <block wx:else>
    <view class="bd-count">{{onlineCount}} 台在线 · 共 {{devices.length}} 台设备</view>

    <view
      wx:for="{{devices}}"
      wx:key="deviceId"
      class="bd-card {{item.online ? '' : 'bd-card--offline'}}"
    >
      <view class="bd-card-head">
        <view class="bd-card-title-row">
          <view class="row gap-8">
            <view class="bd-online-dot {{item.online ? 'bd-online-dot--on' : ''}}"></view>
            <text class="bd-card-title ellipsis">{{item.name}}</text>
          </view>
          <text class="bd-tag {{item.online ? 'bd-tag--online' : 'bd-tag--offline'}}">{{item.statusLabel}}</text>
        </view>
        <text class="bd-card-sub">{{item.shortId}}{{item.versionLabel ? ' · ' + item.versionLabel : ''}}</text>
      </view>

      <view class="bd-card-meta">
        <text>最近活跃 {{item.lastSeenLabel}}</text>
        <text>首次接入 {{item.trustedLabel}}</text>
      </view>

      <view class="bd-card-actions">
        <block wx:if="{{pendingRevoke !== item.deviceId}}">
          <view class="bd-btn-revoke" data-id="{{item.deviceId}}" bindtap="onAskRevoke">吊销</view>
        </block>
        <block wx:else>
          <text class="bd-confirm-text">吊销后此设备立即断开、不可恢复，确定？</text>
          <view class="bd-btn-group">
            <view class="bd-btn-cancel" bindtap="onCancelRevoke">取消</view>
            <view class="bd-btn-confirm" bindtap="onConfirmRevoke">确认吊销</view>
          </view>
        </block>
      </view>
    </view>
  </block>
</view>
