<!-- 胶囊输入框：float=悬浮 / dock=停靠。
     结构对齐设计稿：上半输入区，下半工具条（+ 附件 / 模型胶囊 / 麦克风 / 发送），
     其余配置项（助手、工作流、项目、标记）落在下方 chip 条。 -->

<view
  class="composer composer--{{mode}} {{focus ? 'composer--focus' : ''}}"
  style="{{mode === 'float' && keyboardHeight > 0 ? 'bottom:' + keyboardHeight + 'px;' : ''}}"
>

  <!-- 命令补全面板（输入以 / 开头时浮出） -->
  <view wx:if="{{commands.length > 0}}" class="cmd-panel">
    <view
      wx:for="{{commands}}"
      wx:key="name"
      class="cmd-item"
      hover-class="hover-dim"
      data-name="{{item.name}}"
      bindtap="onCommandPick"
    >
      <text class="cmd-name t-mono">/{{item.name}}</text>
      <text class="cmd-desc ellipsis">{{item.description}}</text>
    </view>
  </view>

  <!-- 附件条 -->
  <scroll-view wx:if="{{attachments.length > 0}}" class="attach-bar" scroll-x>
    <view class="attach-bar-row row">
      <view wx:for="{{attachments}}" wx:key="path" class="attach-chip row">
        <image
          wx:if="{{item.type === 'image'}}"
          class="attach-thumb"
          src="{{item.localPath}}"
          mode="aspectFill"
        />
        <view wx:else class="attach-file-icon icon icon-file"></view>
        <text class="attach-name ellipsis">{{item.name}}</text>
        <view wx:if="{{!item.uploaded}}" class="attach-uploading">
          <view class="status-spinner"></view>
        </view>
        <view
          class="attach-remove"
          hover-class="hover-dim"
          data-index="{{index}}"
          bindtap="onRemoveAttachment"
        >
          <view class="icon icon-close-sm"></view>
        </view>
      </view>
    </view>
  </scroll-view>

  <view class="composer-shell">
    <!-- 上半：输入区（录音 / 转写时由覆盖层替换） -->
    <view wx:if="{{recording}}" class="voice-overlay row">
      <view class="voice-pulse"></view>
      <text class="voice-hint">松开结束，语音将转成文字</text>
    </view>
    <view wx:elif="{{transcribing}}" class="voice-overlay row">
      <view class="status-spinner"></view>
      <text class="voice-hint">转写中…</text>
    </view>
    <textarea
      wx:else
      class="composer-input"
      value="{{localValue}}"
      placeholder="{{placeholder}}"
      placeholder-style="color:#b3b0ab"
      auto-height
      maxlength="8000"
      show-confirm-bar="{{false}}"
      confirm-type="send"
      disabled="{{disabled}}"
      adjust-position="{{false}}"
      cursor-spacing="16"
      bindinput="onInput"
      bindfocus="onFocus"
      bindblur="onBlur"
      bindconfirm="onSend"
      bindkeyboardheightchange="onKeyboardHeight"
    />

    <!-- 下半：工具条 -->
    <view class="composer-tools row">
      <view
        class="composer-btn composer-btn--plus"
        hover-class="hover-dim"
        bindtap="onAddAttachment"
      >
        <view class="icon icon-sm icon-plus"></view>
      </view>

      <!-- 模型胶囊：点开「模型 / 推理强度 / 权限」配置面板 -->
      <view
        wx:if="{{modelChip.value}}"
        class="composer-model row"
        hover-class="hover-dim"
        bindtap="onModelTap"
      >
        <view class="icon icon-shield composer-model-shield"></view>
        <text class="composer-model-name ellipsis">{{modelChip.value}}</text>
        <text wx:if="{{modelChip.effort}}" class="composer-model-effort">{{modelChip.effort}}</text>
      </view>

      <view class="grow"></view>

      <!-- 语音：按住说话 -->
      <view
        class="composer-btn {{recording ? 'composer-btn--rec' : ''}}"
        hover-class="hover-dim"
        bindtouchstart="onVoiceStart"
        bindtouchend="onVoiceEnd"
        bindtouchcancel="onVoiceCancel"
      >
        <view class="icon icon-sm icon-mic"></view>
      </view>

      <view
        class="composer-btn composer-send {{running || canSend ? 'composer-send--active' : ''}}"
        hover-class="composer-send--hover"
        bindtap="onSend"
      >
        <view wx:if="{{running}}" class="icon icon-sm icon-stop"></view>
        <view wx:elif="{{canSend}}" class="icon icon-sm icon-arrow-up-white"></view>
        <view wx:else class="icon icon-sm icon-arrow-up"></view>
      </view>
    </view>
  </view>

  <!-- 其余配置 chips（助手/工作流/项目/标记；模型与权限已收进模型胶囊） -->
  <scroll-view wx:if="{{extraChips.length > 0}}" class="chip-bar" scroll-x>
    <view class="chip-bar-row row">
      <view
        wx:for="{{extraChips}}"
        wx:key="key"
        class="config-chip row"
        hover-class="hover-dim"
        data-key="{{item.key}}"
        bindtap="onChipTap"
      >
        <text class="config-chip-value ellipsis">{{item.value}}</text>
        <view class="icon icon-chevron-down config-chip-chevron"></view>
      </view>
    </view>
  </scroll-view>

  <!-- 键盘占位（仅 dock）：等高于键盘，把输入框顶到键盘上沿，页面消息区自动压缩 -->
  <view
    wx:if="{{mode === 'dock' && keyboardHeight > 0}}"
    class="kb-spacer"
    style="height:{{keyboardHeight}}px"
  ></view>
</view>
