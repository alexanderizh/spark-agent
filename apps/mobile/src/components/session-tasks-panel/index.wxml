<!-- 会话内定时任务面板：任务列表 + 新建表单 + 启停/立即执行/删除 -->

<view wx:if="{{show}}" class="tasks-mask" bindtap="onClose" catchtouchmove="noop">
  <view class="tasks-sheet" catchtap="noop">
    <view class="tasks-head row">
      <text class="tasks-title">定时任务</text>
      <view class="tasks-add {{creating ? 'tasks-add--on' : ''}}" hover-class="hover-dim" bindtap="onToggleCreate">
        <text>{{creating ? '收起' : '+ 新建'}}</text>
      </view>
    </view>

    <!-- 新建表单 -->
    <view wx:if="{{creating}}" class="task-form">
      <view class="task-field">
        <text class="task-label">任务名称</text>
        <input class="task-input" value="{{form.name}}" placeholder="如：每日站会提醒" data-field="name" bindinput="onFieldInput" />
      </view>
      <view class="task-field">
        <text class="task-label">提示词（到达时间后自动在该会话发送）</text>
        <textarea class="task-textarea" value="{{form.prompt}}" placeholder="要执行的内容…" maxlength="2000" data-field="prompt" bindinput="onFieldInput" auto-height />
      </view>
      <view class="task-field">
        <text class="task-label">触发方式</text>
        <view class="task-seg row">
          <view class="task-seg-item {{form.triggerType === 'once' ? 'task-seg-item--on' : ''}}" data-type="once" bindtap="onTriggerType">单次</view>
          <view class="task-seg-item {{form.triggerType === 'interval' ? 'task-seg-item--on' : ''}}" data-type="interval" bindtap="onTriggerType">固定间隔</view>
          <view class="task-seg-item {{form.triggerType === 'cron' ? 'task-seg-item--on' : ''}}" data-type="cron" bindtap="onTriggerType">Cron</view>
        </view>
      </view>
      <view wx:if="{{form.triggerType === 'once'}}" class="task-field">
        <text class="task-label">执行时间</text>
        <picker mode="date" value="{{form.date}}" bindchange="onDateChange">
          <view class="task-picker row">
            <text>{{form.date}} {{form.time}}</text>
            <view class="icon icon-chevron-down"></view>
          </view>
        </picker>
        <picker mode="time" value="{{form.time}}" bindchange="onTimeChange">
          <view class="task-picker row">
            <text>选择时间</text>
            <view class="icon icon-chevron-down"></view>
          </view>
        </picker>
      </view>
      <view wx:elif="{{form.triggerType === 'interval'}}" class="task-field">
        <text class="task-label">间隔（分钟，最小 1）</text>
        <input class="task-input" type="number" value="{{form.intervalMinutes}}" data-field="intervalMinutes" bindinput="onFieldInput" />
      </view>
      <view wx:elif="{{form.triggerType === 'cron'}}" class="task-field">
        <text class="task-label">Cron 表达式（5 段）</text>
        <input class="task-input" value="{{form.cron}}" placeholder="30 9 * * 1-5" data-field="cron" bindinput="onFieldInput" />
      </view>
      <view class="task-form-actions row">
        <view class="task-btn task-btn--ghost" hover-class="hover-dim" bindtap="onToggleCreate">取消</view>
        <view class="task-btn task-btn--primary {{formSubmitting ? 'task-btn--disabled' : ''}}" hover-class="hover-dim" bindtap="onCreate">
          <text>{{formSubmitting ? '创建中…' : '创建任务'}}</text>
        </view>
      </view>
    </view>

    <!-- 任务列表 -->
    <scroll-view class="tasks-list" scroll-y>
      <view wx:if="{{loading}}" class="tasks-empty"><view class="status-spinner"></view><text class="t-caption">加载中…</text></view>
      <view wx:elif="{{tasks.length === 0 && !creating}}" class="tasks-empty">
        <text class="t-caption">当前会话还没有定时任务</text>
      </view>
      <view wx:for="{{tasks}}" wx:key="id" class="task-item">
        <view class="task-item-head row">
          <view class="dot {{item.enabled ? 'dot-success' : ''}}"></view>
          <text class="task-item-name ellipsis grow">{{item.name}}</text>
          <view class="task-item-action" hover-class="hover-dim" data-id="{{item.id}}" data-enabled="{{item.enabled}}" bindtap="onToggle">
            <text>{{item.enabled ? '暂停' : '启用'}}</text>
          </view>
          <view class="task-item-action" hover-class="hover-dim" data-id="{{item.id}}" bindtap="onRunNow">执行</view>
          <view class="task-item-action task-item-action--danger" hover-class="hover-dim" data-id="{{item.id}}" bindtap="onDelete">删除</view>
        </view>
        <text class="task-item-prompt">{{item.prompt}}</text>
        <view class="task-item-meta row">
          <text class="t-caption">{{item.triggerLabel}}</text>
          <text wx:if="{{item.nextLabel}}" class="t-caption">下次 {{item.nextLabel}}</text>
          <text wx:if="{{item.lastLabel}}" class="t-caption">上次 {{item.lastLabel}}</text>
        </view>
        <text wx:if="{{item.lastError}}" class="task-item-error">{{item.lastError}}</text>
      </view>
    </scroll-view>
  </view>
</view>
