.captcha {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 16rpx;
}

.captcha-img {
  width: 200rpx;
  height: 88rpx;
  border-radius: 20rpx;
  background: #fff;
  border: 1rpx solid #e5e2dd;
  box-sizing: border-box;
  flex: none;
}

.captcha-failed {
  width: 200rpx;
  height: 88rpx;
  border-radius: 20rpx;
  background: #fff;
  border: 1rpx solid #e5e2dd;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  flex: none;
  text-align: center;
  line-height: 1.3;
}

.captcha-refresh {
  padding: 12rpx 26rpx;
  border-radius: 999rpx;
  background: #fff;
  border: 1rpx solid #e5e2dd;
  box-sizing: border-box;
  flex: none;
}

.captcha-refresh--hover {
  background: #f2f1ef;
}

.captcha-refresh-text {
  font-size: 24rpx;
  color: #6b6b6b;
}
