{
  "name": "@spark/mobile",
  "version": "1.7.2",
  "private": true,
  "description": "SparkWork 移动端（微信小程序）— 桌面端的移动伴侣：底部 tab 导航（工作台/项目/我的）、项目内直建会话、筛选条件本地记忆，账号登录同步、同步状态、设备与会话管理",
  "scripts": {
    "dev": "node scripts/build.mjs --watch",
    "build": "node scripts/build.mjs && node scripts/verify-dist.mjs && node scripts/verify-wxml-methods.mjs",
    "theme": "node scripts/build-theme.mjs",
    "icons": "node scripts/gen-tabbar-icons.mjs",
    "verify": "node scripts/verify-dist.mjs && node scripts/verify-wxml-methods.mjs",
    "release:check": "node scripts/preflight-release.mjs",
    "smoke": "node scripts/smoke-api.mjs",
    "smoke:boot": "node scripts/smoke-boot.mjs",
    "smoke:theme": "node scripts/smoke-theme.mjs",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "smoke:relay": "node scripts/smoke-relay.mjs",
    "smoke:chat-stream": "node scripts/smoke-chat-stream.mjs",
    "smoke:interactions": "node scripts/smoke-interactions.mjs",
    "smoke:home-composer": "node scripts/smoke-home-composer.mjs",
    "smoke:chat-upgrade": "node scripts/smoke-chat-upgrade.mjs",
    "smoke:chat-order": "node scripts/smoke-chat-order.mjs",
    "smoke:chat-gap": "node scripts/smoke-chat-gap.mjs",
    "smoke:chat-turn-rail": "node scripts/smoke-chat-turn-rail.mjs",
    "smoke:config-sheet": "node scripts/smoke-config-sheet.mjs",
    "smoke:filters": "node scripts/smoke-filters.mjs",
    "e2e:home-alignment": "node scripts/devtools-home-alignment-e2e.mjs",
    "e2e:project-composer": "node scripts/e2e-project-composer.mjs",
    "e2e:filters-probe": "node scripts/e2e-filters-probe.mjs",
    "e2e:relay": "node scripts/e2e-relay-prod.mjs"
  },
  "devDependencies": {
    "miniprogram-api-typings": "^3.12.3",
    "miniprogram-automator": "^0.12.1",
    "typescript": "^5.5.0"
  }
}
