[
  {
    "provider": "xai",
    "modelId": "grok-imagine-video",
    "displayName": "Grok Imagine Video",
    "capabilities": ["video.generate", "video.image_to_video", "video.reference_to_video", "video.edit", "video.extend"],
    "endpoint": "/v1/videos/generations",
    "pollingEndpoint": "/v1/videos/{request_id}",
    "requestBody": {
      "model": {
        "type": "string",
        "required": false,
        "default": "grok-imagine-video",
        "description": "Model to be used"
      },
      "prompt": {
        "type": "string",
        "required": "conditional",
        "description": "Prompt for video generation. Required for T2V and R2V. Optional for I2V — when omitted, generates from image alone."
      },
      "image": {
        "type": "object",
        "required": false,
        "description": "Input image for image-to-video generation",
        "properties": {
          "url": {
            "type": "string",
            "description": "Public URL or base64-encoded data URL (JPEG, PNG, WebP)"
          },
          "file_id": {
            "type": "string",
            "description": "File ID from xAI Files API (mutually exclusive with url)"
          }
        }
      },
      "reference_images": {
        "type": "array",
        "required": false,
        "description": "Reference images for reference-to-video (R2V) generation",
        "items": {
          "type": "object",
          "properties": {
            "url": { "type": "string" },
            "file_id": { "type": "string" }
          }
        }
      },
      "aspect_ratio": {
        "type": "string",
        "required": false,
        "enum": ["1:1", "16:9", "9:16", "4:3", "3:4", "3:2", "2:3"],
        "description": "Aspect ratio for the video"
      },
      "duration": {
        "type": "integer",
        "required": false,
        "default": 8,
        "min": 1,
        "max": 15,
        "description": "Video duration in seconds. Range [1, 15], default 8. Also accepts 'seconds' for OpenAI API compatibility."
      },
      "resolution": {
        "type": "string",
        "required": false,
        "enum": ["480p", "720p", "1080p"],
        "description": "Resolution for the video"
      },
      "output": {
        "type": "object",
        "required": false,
        "description": "Output configuration for video upload",
        "properties": {
          "upload_url": {
            "type": "string",
            "required": true,
            "description": "Signed URL to upload the generated video via HTTP PUT"
          }
        }
      },
      "storage_options": {
        "type": "object",
        "required": false,
        "description": "Storage options for the generated file",
        "properties": {
          "filename": {
            "type": "string",
            "required": true,
            "description": "Filename for the stored file"
          },
          "expires_after": {
            "type": "integer",
            "required": false,
            "max": 2592000,
            "description": "Seconds until auto-expiry (max 30 days)"
          },
          "public_url": {
            "type": "boolean",
            "required": false,
            "description": "Whether to create a public URL"
          }
        }
      },
      "user": {
        "type": "string",
        "required": false,
        "description": "Unique identifier representing end-user"
      }
    },
    "videoEditsEndpoint": {
      "path": "/v1/videos/edits",
      "method": "POST",
      "description": "Edit a video based on a prompt",
      "parameters": {
        "video": {
          "type": "object",
          "required": true,
          "description": "Video input for editing (URL or file_id)"
        },
        "prompt": {
          "type": "string",
          "required": true
        }
      }
    },
    "videoExtensionsEndpoint": {
      "path": "/v1/videos/extensions",
      "method": "POST",
      "description": "Extend a video by generating continuation",
      "parameters": {
        "video": {
          "type": "object",
          "required": true
        },
        "prompt": {
          "type": "string",
          "required": true,
          "description": "Prompt describing what should happen next"
        },
        "duration": {
          "type": "integer",
          "default": 6,
          "min": 1,
          "max": 10,
          "description": "Extension duration in seconds [1-10]"
        }
      }
    },
    "defaults": {
      "duration": 8,
      "resolution": "720p"
    },
    "limits": {
      "durationRange": [1, 15],
      "extensionRange": [1, 10],
      "rateLimit": "70 requests/minute",
      "maxImageSize": "20MiB",
      "acceptedImageFormats": ["jpg", "jpeg", "png", "webp"],
      "acceptedVideoFormats": ["mp4"]
    },
    "response": {
      "taskIdPath": "request_id",
      "statusPath": "status",
      "statusEnum": ["pending", "done", "failed"],
      "resultPath": "video.url",
      "durationPath": "video.duration",
      "errorPath": "error"
    },
    "errorCodes": {
      "invalid_argument": "Invalid request parameters",
      "permission_denied": "Access denied",
      "failed_precondition": "Precondition failed",
      "service_unavailable": "Service temporarily unavailable",
      "internal_error": "Internal server error"
    },
    "pricing": {
      "output": "$0.050/second"
    },
    "regions": ["us-east-1", "eu-west-1", "us-west-2"],
    "docs": [
      "https://docs.x.ai/developers/models/grok-imagine-video",
      "https://docs.x.ai/developers/rest-api-reference/inference/videos"
    ],
    "status": "COMPLETE"
  },
  {
