        "items": {
          "type": "object",
          "properties": {
            "url": { "type": "string" },
            "file_id": { "type": "string" }
          }
        }
      },
      "storage_options": {
        "type": "object",
        "required": false,
        "description": "Storage options for the generated file",
        "properties": {
          "filename": {
            "type": "string",
            "required": true,
            "description": "Filename for the stored file"
          },
          "expires_after": {
            "type": "integer",
            "required": false,
            "max": 2592000,
            "description": "Seconds until auto-expiry (max 30 days)"
          },
          "public_url": {
            "type": "boolean",
            "required": false,
            "description": "Whether to create a public URL"
          }
        }
      },
      "user": {
        "type": "string",
        "required": false,
        "description": "Unique identifier representing end-user"
      }
    },
    "defaults": {
      "response_format": "url"
    },
    "limits": {
      "rateLimit": "300 requests/minute",
      "maxImageSize": "20MiB",
      "acceptedImageFormats": ["jpg", "jpeg", "png", "webp"],
      "aspectRatioCount": 15
    },
    "response": {
      "dataPath": "data",
      "dataType": "array",
      "itemProperties": {
        "url": { "type": "string", "nullable": true },
        "b64_json": { "type": "string", "nullable": true },
        "mime_type": { "type": "string", "nullable": true },
        "storage_error": { "type": "string", "nullable": true },
        "file_output": {
          "type": "object",
          "properties": {
            "file_id": { "type": "string" },
            "filename": { "type": "string" },
            "expires_at": { "type": "integer", "nullable": true },
            "public_url": { "type": "string", "nullable": true },
            "public_url_expires_at": { "type": "integer", "nullable": true }
          }
        }
      }
    },
    "pricing": {
      "output": "$0.05 per image"
    },
    "regions": ["us-east-1", "eu-west-1", "us-west-2"],
    "docs": [
      "https://docs.x.ai/developers/models/grok-imagine-image-quality",
      "https://docs.x.ai/developers/rest-api-reference/inference/images"
    ],
    "status": "COMPLETE"
  }
]
