    "displayName": "Kling O1",
    "capabilities": ["video.generate", "video.image_to_video"],
    "endpoint": "POST /v1/videos/text2video",
    "requestBody": {
      "model": {
        "type": "string",
        "required": true,
        "enum": ["kling-video-o1"]
      },
      "prompt": {
        "type": "string",
        "required": true,
        "description": "视频文本描述"
      },
      "duration": {
        "type": "integer",
        "required": false,
        "enum": [5, 10],
        "description": "视频时长（秒）"
      },
      "aspect_ratio": {
        "type": "string",
        "required": false,
        "enum": ["16:9", "9:16", "1:1"],
        "description": "视频比例"
      },
      "mode": {
        "type": "string",
        "required": false,
        "enum": ["standard", "professional"],
        "description": "生成模式"
      },
      "negative_prompt": {
        "type": "string",
        "required": false,
        "description": "负面提示词"
      }
    },
    "response": {
      "taskIdPath": "task_id"
    },
    "docs": ["https://klingapi.com/zh/docs/text-to-video"],
