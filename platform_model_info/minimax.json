  {
    "provider": "minimax",
    "modelId": "image-01",
    "displayName": "Image 01",
    "capabilities": ["image.generate"],
    "endpoint": "https://api.minimaxi.com/v1/image_generation",
    "requestBody": {
      "model": {
        "type": "string",
        "required": true,
        "enum": ["image-01", "image-01-live"],
        "default": "image-01"
      },
      "prompt": {
        "type": "string",
        "required": true,
        "maxLength": 1500,
        "description": "文本描述，最长1500字符"
      },
      "aspect_ratio": {
        "type": "string",
        "required": false,
        "default": "1:1",
        "enum": ["1:1", "16:9", "4:3", "3:2", "2:3", "3:4", "9:16", "21:9"],
        "description": "宽高比"
      },
      "width": {
        "type": "integer",
        "required": false,
        "min": 512,
        "max": 2048,
        "description": "宽度，需为8的倍数（仅image-01模型）"
      },
      "height": {
        "type": "integer",
        "required": false,
        "min": 512,
        "max": 2048,
        "description": "高度，需为8的倍数（仅image-01模型）"
      },
      "response_format": {
        "type": "string",
        "required": false,
        "default": "url",
        "enum": ["url", "base64"],
        "description": "响应格式"
      },
      "seed": {
        "type": "integer",
        "required": false,
        "description": "随机种子，用于复现结果"
      },
      "n": {
        "type": "integer",
        "required": false,
        "default": 1,
        "min": 1,
        "max": 9,
        "description": "单次生成图片数量"
      },
      "prompt_optimizer": {
        "type": "boolean",
        "required": false,
        "default": false,
        "description": "是否开启prompt自动优化"
      },
      "aigc_watermark": {
        "type": "boolean",
        "required": false,
        "default": false,
        "description": "是否添加水印"
      },
      "style": {
        "type": "object",
        "required": false,
        "description": "风格设置（仅image-01-live生效）",
        "properties": {
          "style_type": {
            "type": "string",
            "description": "风格类型"
          },
          "style_weight": {
            "type": "number",
            "description": "风格权重"
          }
        }
      }
    },
    "defaults": {
      "aspect_ratio": "1:1",
      "response_format": "url",
      "n": 1,
      "prompt_optimizer": false,
      "aigc_watermark": false
    },
    "limits": {
      "promptMaxLength": 1500,
      "widthRange": [512, 2048],
      "heightRange": [512, 2048],
      "nRange": [1, 9],
      "sizeMultiple": 8
    },
    "response": {
      "imageUrlsPath": "data.image_urls",
      "imageBase64Path": "data.image_base64",
      "successCountPath": "metadata.success_count",
      "failedCountPath": "metadata.failed_count"
    },
    "errors": {
      "0": "成功",
      "1002": "限流",
      "1004": "鉴权失败",
      "1008": "余额不足",
      "1026": "敏感内容",
      "2013": "参数异常",
      "2049": "无效API key"
    },
    "docs": ["https://platform.minimaxi.com/docs/api-reference/image-generation-t2i"],
    "status": "COMPLETE"
  },
