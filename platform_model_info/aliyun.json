[
  {
    "provider": "aliyun",
    "modelId": "wan2.7-image-pro",
    "displayName": "Wan 2.7 Image Pro",
    "capabilities": ["image.generate", "image.edit"],
    "endpoint": "POST /image-generation/generation",
    "requestBody": {
      "model": "wan2.7-image-pro",
      "input": {
        "messages": [
          {
            "role": "user",
            "content": [
              { "text": "prompt" },
              { "image": "reference image url/dataUrl" }
            ]
          }
        ]
      },
      "parameters": {
        "size": ["1:1", "4:3", "3:4", "16:9", "9:16", "3:2", "2:3", "21:9", "auto"],
        "resolution": ["2K", "4K", "auto"],
        "n": [1, 2, 3, 4],
        "negative_prompt": "optional",
        "seed": "optional",
        "prompt_extend": true,
        "watermark": false
      },
      "headers": {
        "X-DashScope-Async": "enable"
      }
    },
    "limits": {
      "asyncOnly": true,
      "supportsInputImages": true
    },
    "response": {
      "taskIdPath": "task_id",
      "pollPath": "/tasks/{taskId}",
      "resultPaths": ["data[].url", "data[].image_url", "output.url", "url"]
    },
    "docs": ["https://bailian.console.aliyun.com/cn-beijing/?tab=model#/model-market"],
    "status": "COMPLETE"
  },
