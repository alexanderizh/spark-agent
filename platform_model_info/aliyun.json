      },
      "headers": {
        "X-DashScope-Async": "enable (必选)"
      }
    },
    "limits": {
      "asyncOnly": true,
      "supportsFirstFrame": true,
      "supportsLastFrame": true,
      "supportsDrivingAudio": true,
      "supportsVideoContinuation": "first_clip 续写",
