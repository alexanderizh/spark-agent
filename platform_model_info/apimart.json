[
  {
    "provider": "apimart",
    "modelId": "wan2.7-image",
    "displayName": "wan2.7 Image Generation & Editing",
    "capabilities": ["text-to-image", "image-to-image", "image-editing"],
    "endpoint": "https://api.apimart.ai/v1/images/generations",
    "requestBody": {
      "model": {
        "type": "string",
        "required": true,
        "enum": ["wan2.7-image-pro", "wan2.7-image"]
      },
      "prompt": {
        "type": "string",
        "required": false,
        "maxLength": 5000
      },
      "image_urls": {
        "type": "array<string>",
        "required": false,
        "maxItems": 9,
        "formats": ["JPEG", "PNG", "WEBP", "BMP"],
        "sizeRange": "240-8000px",
        "aspectRatioRange": "1:8 ~ 8:1",
        "maxSize": "20MB"
      },
      "n": {
        "type": "integer",
        "default": 1,
        "standardMode": "1-4",
        "sequentialMode": "1-12"
      },
      "size": {
        "type": "string",
        "enum": ["1K", "2K", "4K", "1:1", "16:9", "9:16", "4:3", "3:4", "3:2", "2:3"]
      },
      "resolution": {
        "type": "string",
        "enum": ["1K", "2K", "4K"]
      },
      "negative_prompt": {
        "type": "string",
        "required": false
      },
      "watermark": {
        "type": "boolean",
        "default": false
      },
      "seed": {
        "type": "integer",
        "range": "0-2147483647"
      },
      "thinking_mode": {
        "type": "boolean",
        "default": true
      },
      "enable_sequential": {
        "type": "boolean",
        "default": false
      },
      "bbox_list": {
        "type": "array",
        "maxBoxesPerImage": 2
      },
      "color_palette": {
        "type": "array<object>",
        "entriesRange": "3-10",
        "fields": ["hex", "ratio"]
      }
    },
    "defaults": {
      "n": 1,
      "watermark": false,
      "thinking_mode": true,
      "enable_sequential": false
    },
    "limits": {
      "promptMaxLength": 5000,
      "maxReferenceImages": 9,
      "standardModeMaxImages": 4,
      "sequentialModeMaxImages": 12,
      "imageSizeRange": "240-8000px",
      "imageMaxSize": "20MB"
    },
    "response": {
      "success": {
        "code": "success",
        "data": [
          {
            "task_id": "string",
            "status": "processing"
          }
        ]
      },
      "errors": {
        "400": "Invalid request parameters",
        "401": "Authentication failed",
        "402": "Insufficient balance",
        "429": "Too many requests",
        "500": "Internal server error"
      }
    },
    "docs": ["https://docs.apimart.ai/en/api-reference/images/wan2.7-image/generation.md"]
  },
