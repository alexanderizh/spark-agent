      "mode": { "type": "string", "required": false, "enum": ["参考生成", "首尾帧", "版权IP生成"] },
      "aspectRatio": {
        "type": "string",
        "required": false,
        "default": "智能比例",
        "enum": ["智能比例", "21:9", "16:9", "4:3", "1:1", "3:4", "9:16"]
      },
      "durationMode": { "type": "string", "required": false, "enum": ["按秒数", "智能时长"], "default": "按秒数" },
      "durationSeconds": { "type": "integer", "required": false, "default": 5, "min": 1, "max": 15 },
      "resolution": { "type": "string", "required": false, "default": "720p", "enum": ["480p", "720p", "1080p"] },
      "count": { "type": "integer", "required": false, "default": 4, "min": 1, "max": 4 },
      "generateAudio": { "type": "boolean", "required": false, "default": true },
      "seed": { "type": "integer", "required": false, "default": -1 },
      "searchEnabled": { "type": "boolean", "required": false, "default": false },
      "timeoutHours": { "type": "integer", "required": false, "default": 48, "min": 1, "max": 48 },
      "firstFrame": { "type": "string", "required": false, "note": "首帧图片 URL / dataUrl" },
      "lastFrame": { "type": "string", "required": false, "note": "尾帧图片 URL / dataUrl" },
      "referenceImages": { "type": "array<string>", "required": false, "maxItems": 9 },
      "video": { "type": "string", "required": false, "note": "视频编辑输入视频 URL / dataUrl" }
    },
    "defaults": {
      "mode": "参考生成",
      "aspectRatio": "智能比例",
      "durationMode": "按秒数",
      "durationSeconds": 5,
      "resolution": "720p",
      "count": 4,
      "generateAudio": true,
      "seed": -1,
      "searchEnabled": false,
      "timeoutHours": 48
    },
    "limits": {
      "durationRange": "1-15 seconds",
      "promptMaxLength": 8000,
      "maxImageUrls": 9,
      "maxVideoUrls": 1,
      "fps": 24,
      "timeoutHours": 48
    },
    "response": {
      "mode": "async_polling",
      "taskIdPaths": ["id", "task_id", "request_id"],
      "statusEndpoint": "/v3/contents/generations/{taskId}",
      "resultPaths": ["data[].video_url", "data[].url", "data.video_url", "output.video_url", "output.url", "video_url", "url"]
    },
    "docs": [
