        "type": "float",
        "default": 1,
        "description": "Limits model choices to top tokens summing to P"
      },
      "seed": {
        "type": "integer",
        "required": false,
        "description": "Deterministic sampling for reproducible results"
      },
      "response_format": {
        "type": "object",
        "required": false,
        "description": "Forces specific output format"
      },
      "stop": {
        "type": "array",
        "required": false,
        "description": "Stop generation on specified tokens"
      },
      "image_config": {
        "type": "object",
        "required": false,
        "description": "Control aspect ratio and other image parameters"
      }
    },
    "headers": {
      "Authorization": "Bearer <OPENROUTER_API_KEY>",
